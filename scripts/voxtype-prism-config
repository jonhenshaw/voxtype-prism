#!/usr/bin/env python3
"""Explicit, reversible Voxtype configuration helper for the Omarchy plugin."""

from __future__ import annotations

import argparse
import json
import os
import re
import secrets
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path

MAX_CONFIG_BYTES = 512 * 1024
MAX_STATE_BYTES = 64 * 1024


def xdg_path(env_name: str, fallback: Path) -> Path:
    value = os.environ.get(env_name, "")
    return Path(value).expanduser() if value else fallback


def config_path() -> Path:
    return xdg_path("XDG_CONFIG_HOME", Path.home() / ".config") / "voxtype" / "config.toml"


def state_path() -> Path:
    return (
        xdg_path("XDG_STATE_HOME", Path.home() / ".local" / "state")
        / "voxtype-prism"
        / "setup.json"
    )


def legacy_state_path() -> Path:
    return (
        xdg_path("XDG_STATE_HOME", Path.home() / ".local" / "state")
        / "voxtype-signal-osd"
        / "setup.json"
    )


def existing_state_path() -> Path:
    primary = state_path()
    legacy = legacy_state_path()
    return primary if path_entry_exists(primary) or not path_entry_exists(legacy) else legacy


def path_entry_exists(path: Path) -> bool:
    try:
        os.lstat(path)
        return True
    except FileNotFoundError:
        return False


def osd_section_bounds(text: str) -> tuple[int, int] | None:
    lines = text.splitlines(keepends=True)
    offset = 0
    start: int | None = None
    for line in lines:
        section = re.match(r"^\s*\[([^\]]+)\]\s*(?:#.*)?$", line)
        if section:
            if start is not None:
                return start, offset
            if section.group(1).strip() == "osd":
                start = offset + len(line)
        offset += len(line)
    return None if start is None else (start, len(text))


def read_osd_enabled(text: str) -> bool:
    bounds = osd_section_bounds(text)
    if bounds is None:
        return True
    start, end = bounds
    for line in text[start:end].splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or not stripped.startswith("enabled"):
            continue
        key, separator, value = stripped.partition("=")
        if separator and key.strip() == "enabled":
            token = value.split("#", 1)[0].strip()
            if token in {"true", "false"}:
                return token == "true"
    return True


def set_osd_enabled(text: str, enabled: bool) -> str:
    value = "true" if enabled else "false"
    bounds = osd_section_bounds(text)
    if bounds is None:
        separator = "" if not text or text.endswith("\n") else "\n"
        return f"{text}{separator}\n[osd]\nenabled = {value}\n"

    start, end = bounds
    body = text[start:end]
    lines = body.splitlines(keepends=True)
    offset = 0
    for line in lines:
        stripped = line.strip()
        if not stripped.startswith("#") and stripped.startswith("enabled"):
            key, separator, raw_value = stripped.partition("=")
            token = raw_value.split("#", 1)[0].strip() if separator else ""
            if key.strip() == "enabled" and token in {"true", "false"}:
                indent = line[: len(line) - len(line.lstrip())]
                comment = ""
                if "#" in raw_value:
                    comment = "  #" + raw_value.split("#", 1)[1].rstrip("\r\n")
                newline = "\r\n" if line.endswith("\r\n") else "\n" if line.endswith("\n") else ""
                replacement = f"{indent}enabled = {value}{comment}{newline}"
                return text[: start + offset] + replacement + text[start + offset + len(line) :]
        offset += len(line)

    return text[:start] + f"enabled = {value}\n" + text[start:]


def read_config(path: Path) -> str:
    nofollow = getattr(os, "O_NOFOLLOW", 0)
    if nofollow == 0:
        raise RuntimeError("O_NOFOLLOW is required for Voxtype config access")
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | nofollow)
    except FileNotFoundError as error:
        raise RuntimeError(f"Voxtype config not found: {path}") from error
    except OSError as error:
        raise RuntimeError(f"Refusing unsafe Voxtype config path: {path}") from error

    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            raise RuntimeError(f"Voxtype config is not a regular file: {path}")
        if metadata.st_size > MAX_CONFIG_BYTES:
            raise RuntimeError(f"Voxtype config is unexpectedly large: {path}")

        chunks: list[bytes] = []
        collected = 0
        while collected <= MAX_CONFIG_BYTES:
            chunk = os.read(descriptor, min(64 * 1024, MAX_CONFIG_BYTES + 1 - collected))
            if not chunk:
                break
            chunks.append(chunk)
            collected += len(chunk)
        if collected > MAX_CONFIG_BYTES:
            raise RuntimeError(f"Voxtype config grew beyond the byte limit: {path}")
        return b"".join(chunks).decode("utf-8")
    finally:
        os.close(descriptor)


def create_backup(config: Path, text: str, timestamp: str) -> Path:
    nofollow = getattr(os, "O_NOFOLLOW", 0)
    if nofollow == 0:
        raise RuntimeError("O_NOFOLLOW is required for Voxtype config backups")

    directory = os.open(
        config.parent,
        os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | nofollow,
    )
    descriptor = -1
    try:
        metadata = os.stat(config.name, dir_fd=directory, follow_symlinks=False)
        if not stat.S_ISREG(metadata.st_mode):
            raise RuntimeError(f"Voxtype config is not a regular file: {config}")
        mode = stat.S_IMODE(metadata.st_mode)
        data = text.encode("utf-8")

        for _ in range(16):
            name = (
                f"{config.name}.voxtype-prism.{timestamp}."
                f"{secrets.token_hex(4)}.bak"
            )
            try:
                descriptor = os.open(
                    name,
                    os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | nofollow,
                    mode,
                    dir_fd=directory,
                )
                break
            except FileExistsError:
                continue
        if descriptor < 0:
            raise RuntimeError(f"Could not allocate a safe config backup in {config.parent}")

        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise RuntimeError("Config backup is not a regular file")
        write_all(descriptor, data)
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        os.fsync(directory)
        return config.with_name(name)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        os.close(directory)


def atomic_write_if_unchanged(path: Path, expected: str, text: str) -> bool:
    mode = path.stat().st_mode & 0o777
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", dir=path.parent, prefix=f".{path.name}.", delete=False
    ) as handle:
        temporary = Path(handle.name)
        handle.write(text)
        handle.flush()
        os.fsync(handle.fileno())
    try:
        os.chmod(temporary, mode)
        if read_config(path) != expected:
            return False
        os.replace(temporary, path)
        temporary = None
        return True
    finally:
        if temporary is not None:
            try:
                temporary.unlink()
            except FileNotFoundError:
                pass


def update_osd_enabled(path: Path, enabled: bool) -> str:
    for _ in range(8):
        current = read_config(path)
        updated = set_osd_enabled(current, enabled)
        if updated == current:
            return current
        if atomic_write_if_unchanged(path, current, updated):
            return current
    raise RuntimeError(f"Voxtype config kept changing during update: {path}")


def restart_voxtype(skip: bool) -> None:
    if skip:
        return
    subprocess.run(["systemctl", "--user", "restart", "voxtype.service"], check=True)
    subprocess.run(["systemctl", "--user", "is-active", "--quiet", "voxtype.service"], check=True)


def check_runtime(skip: bool) -> None:
    if skip:
        return
    for binary in ("voxtype", "voxtype-audio-bridge", "omarchy-shell", "systemctl"):
        if shutil.which(binary) is None:
            raise RuntimeError(f"required command not found: {binary}")
    probe = subprocess.run(
        ["omarchy-shell", "voxtype-prism", "status"],
        check=False,
        capture_output=True,
        text=True,
    )
    if probe.returncode != 0:
        raise RuntimeError(
            "Voxtype Prism is not loaded; enable the plugin before running setup"
        )
    json.loads(probe.stdout)


def wait_prism_ready(skip: bool) -> None:
    if skip:
        return
    for _ in range(30):
        probe = subprocess.run(
            ["omarchy-shell", "voxtype-prism", "status"],
            check=False,
            capture_output=True,
            text=True,
        )
        if probe.returncode == 0:
            try:
                if json.loads(probe.stdout).get("configured") is True:
                    return
            except json.JSONDecodeError:
                pass
        time.sleep(0.2)
    raise RuntimeError("plugin did not become ready after Voxtype restarted")


def open_state_directory(path: Path, create: bool) -> int:
    if create:
        path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    nofollow = getattr(os, "O_NOFOLLOW", 0)
    if nofollow == 0:
        raise RuntimeError("O_NOFOLLOW is required for setup-state access")
    descriptor = os.open(
        path.parent,
        os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | nofollow,
    )
    if not stat.S_ISDIR(os.fstat(descriptor).st_mode):
        os.close(descriptor)
        raise RuntimeError(f"Setup-state parent is not a directory: {path.parent}")
    return descriptor


def write_all(descriptor: int, data: bytes) -> None:
    offset = 0
    while offset < len(data):
        written = os.write(descriptor, data[offset:])
        if written <= 0:
            raise OSError("short write while saving setup state")
        offset += written


def write_state(path: Path, payload: dict[str, object]) -> None:
    data = (json.dumps(payload, indent=2, sort_keys=True) + "\n").encode("utf-8")
    if len(data) > MAX_STATE_BYTES:
        raise RuntimeError(f"Setup state is unexpectedly large: {path}")

    directory = open_state_directory(path, create=True)
    temporary_name = ""
    descriptor = -1
    try:
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW
        for _ in range(16):
            temporary_name = f".{path.name}.tmp.{secrets.token_hex(8)}"
            try:
                descriptor = os.open(temporary_name, flags, 0o600, dir_fd=directory)
                break
            except FileExistsError:
                temporary_name = ""
        if descriptor < 0:
            raise RuntimeError(f"Could not allocate temporary setup state in {path.parent}")
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise RuntimeError("Temporary setup state is not a regular file")

        os.fchmod(descriptor, 0o600)
        write_all(descriptor, data)
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1

        os.replace(
            temporary_name,
            path.name,
            src_dir_fd=directory,
            dst_dir_fd=directory,
        )
        temporary_name = ""
        os.fsync(directory)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if temporary_name:
            try:
                os.unlink(temporary_name, dir_fd=directory)
            except FileNotFoundError:
                pass
        os.close(directory)


def load_state(path: Path) -> dict[str, object] | None:
    if not path_entry_exists(path):
        return None

    try:
        directory = open_state_directory(path, create=False)
    except FileNotFoundError:
        return None
    descriptor = -1
    try:
        try:
            descriptor = os.open(
                path.name,
                os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | os.O_NOFOLLOW,
                dir_fd=directory,
            )
        except FileNotFoundError:
            return None
        except OSError as error:
            raise RuntimeError(f"Refusing unsafe setup-state path: {path}") from error

        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            raise RuntimeError(f"Setup state is not a regular file: {path}")
        if metadata.st_size > MAX_STATE_BYTES:
            raise RuntimeError(f"Setup state is unexpectedly large: {path}")

        chunks: list[bytes] = []
        collected = 0
        while collected <= MAX_STATE_BYTES:
            chunk = os.read(descriptor, min(64 * 1024, MAX_STATE_BYTES + 1 - collected))
            if not chunk:
                break
            chunks.append(chunk)
            collected += len(chunk)
        if collected > MAX_STATE_BYTES:
            raise RuntimeError(f"Setup state grew beyond the byte limit: {path}")
        payload = json.loads(b"".join(chunks).decode("utf-8"))
        if not isinstance(payload, dict):
            raise RuntimeError(f"Setup state must be a JSON object: {path}")
        validate_state_payload(payload, path)
        return payload
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        os.close(directory)


def normalized_path(path: Path) -> Path:
    return Path(os.path.abspath(os.fspath(path.expanduser())))


def validate_state_payload(payload: dict[str, object], path: Path) -> None:
    required_strings = ("backup", "config", "setup_at")
    for key in required_strings:
        if not isinstance(payload.get(key), str) or not str(payload[key]).strip():
            raise RuntimeError(f"Setup state has invalid {key!r}: {path}")
    if not isinstance(payload.get("original_osd_enabled"), bool):
        raise RuntimeError(f"Setup state has invalid 'original_osd_enabled': {path}")
    if "schema_version" in payload:
        schema = payload["schema_version"]
        if isinstance(schema, bool) or not isinstance(schema, int) or schema != 1:
            raise RuntimeError(f"Unsupported setup-state schema: {path}")
    if "restored_at" in payload and not isinstance(payload["restored_at"], str):
        raise RuntimeError(f"Setup state has invalid 'restored_at': {path}")
    if not Path(str(payload["config"])).expanduser().is_absolute():
        raise RuntimeError(f"Setup state config path is not absolute: {path}")
    if not Path(str(payload["backup"])).expanduser().is_absolute():
        raise RuntimeError(f"Setup state backup path is not absolute: {path}")


def require_state_for_config(
    payload: dict[str, object],
    state: Path,
    config: Path,
) -> None:
    recorded = normalized_path(Path(str(payload["config"])))
    expected = normalized_path(config)
    if recorded != expected:
        raise RuntimeError(
            f"Setup state {state} belongs to {recorded}; use --config {recorded}"
        )


def create_initial_state(config: Path) -> dict[str, object]:
    for _ in range(8):
        text = read_config(config)
        timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        backup = create_backup(config, text, timestamp)
        if read_config(config) == text:
            return {
                "backup": str(backup),
                "config": str(normalized_path(config)),
                "original_osd_enabled": read_osd_enabled(text),
                "schema_version": 1,
                "setup_at": datetime.now(timezone.utc).isoformat(),
            }
    raise RuntimeError(f"Voxtype config kept changing during backup: {config}")


def setup(args: argparse.Namespace) -> int:
    config = normalized_path(Path(args.config)) if args.config else normalized_path(config_path())
    state = normalized_path(Path(args.state)) if args.state else normalized_path(state_path())
    check_runtime(args.no_restart)
    existing = load_state(state)

    if existing is None and not args.state:
        legacy = load_state(legacy_state_path())
        if legacy is not None:
            require_state_for_config(legacy, legacy_state_path(), config)
            existing = legacy
            write_state(state, legacy)

    if existing is None:
        existing = create_initial_state(config)
        write_state(state, existing)
    else:
        require_state_for_config(existing, state, config)

    update_osd_enabled(config, False)
    restart_voxtype(args.no_restart)
    wait_prism_ready(args.no_restart)
    print(f"Voxtype Prism is configured. Built-in OSD disabled in {config}")
    print(f"Restore with: {Path(__file__).name} restore")
    return 0


def restore(args: argparse.Namespace) -> int:
    state = normalized_path(Path(args.state)) if args.state else normalized_path(existing_state_path())
    payload = load_state(state)
    if payload is None:
        raise RuntimeError(f"No setup state found: {state}")
    config = normalized_path(Path(args.config)) if args.config else normalized_path(config_path())
    require_state_for_config(payload, state, config)
    original = payload["original_osd_enabled"]
    update_osd_enabled(config, original)
    payload["restored_at"] = datetime.now(timezone.utc).isoformat()
    write_state(state, payload)
    restart_voxtype(args.no_restart)
    print(f"Restored Voxtype OSD enabled={str(original).lower()} in {config}")
    return 0


def status(args: argparse.Namespace) -> int:
    config = Path(args.config).expanduser() if args.config else config_path()
    state = Path(args.state).expanduser() if args.state else existing_state_path()
    text = read_config(config)
    enabled = read_osd_enabled(text)
    print(f"config={config}")
    print(f"built_in_osd_enabled={str(enabled).lower()}")
    print(f"prism_ready={str(not enabled).lower()}")
    print(f"setup_state={state if path_entry_exists(state) else 'missing'}")
    return 0


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    result.add_argument("action", choices=("setup", "restore", "status"))
    result.add_argument("--config", help="Override the Voxtype config path")
    result.add_argument("--state", help="Override the setup-state path")
    result.add_argument("--no-restart", action="store_true", help=argparse.SUPPRESS)
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        if hasattr(os, "geteuid") and os.geteuid() == 0:
            raise RuntimeError("run this helper as your normal desktop user, not root")
        return {"setup": setup, "restore": restore, "status": status}[args.action](args)
    except (OSError, RuntimeError, subprocess.CalledProcessError, json.JSONDecodeError) as error:
        print(f"voxtype-prism-config: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
