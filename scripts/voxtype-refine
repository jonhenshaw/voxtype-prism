        "what",
        "is",
        "are",
        "be",
    }
)


def _is_ident_fragment(token: str) -> bool:
    if not _IDENT_FRAGMENT_RE.fullmatch(token):
        return False
    return not any(character.isupper() for character in token[1:])


_UTTERANCE_VERBS = frozenset(
    {
        "call",
        "open",
        "edit",
        "set",
        "print",
        "clone",
        "sort",
        "look",
        "rename",
        "ship",
        "update",
        "send",
        "help",
        "give",
        "make",
        "use",
        "run",
        "go",
        "get",
        "put",
        "add",
        "remove",
        "create",
        "delete",
        "write",
        "read",
        "what",
        "why",
        "how",
        "please",
        "maybe",
        "think",
        "just",
    }
)


def _utterance_identifier_hint(transcript: str) -> str | None:
    """Join a whole-utterance spoken identifier into snake_case.

    Used when screen context is on but OCR only sees the spaced words that
    were just pasted, not the underscored form.
    """
    stripped = transcript.strip().rstrip(".?!")
    parts = TOKEN_RE.findall(stripped)
    if not 3 <= len(parts) <= 6:
        return None
    if not all(_is_ident_fragment(part) for part in parts):
        return None
    lowered = [part.casefold() for part in parts]
    if any(part in _PROSE_SNAKE_PARTS or part in _UTTERANCE_VERBS for part in lowered):
        return None
    return "_".join(lowered)


def _synthetic_snake_spellings(text: str) -> list[str]:
    """Rebuild snake_case names when OCR turns underscores into spaces."""
    found: list[str] = []
    chunks: list[str] = []
    for line in text.splitlines():
        chunks.extend(line.split("|"))
    for chunk in chunks:
        if any(character in chunk for character in ".?!"):
            continue
        parts = TOKEN_RE.findall(chunk)
        index = 0
        while index < len(parts):
            if not _is_ident_fragment(parts[index]):
                index += 1
                continue
            end = index
            while end < len(parts) and _is_ident_fragment(parts[end]):
                end += 1
            group: list[str] = []

            def flush() -> None:
                if 3 <= len(group) <= 6:
                    lowered = [item.casefold() for item in group]
                    if not any(part in _PROSE_SNAKE_PARTS for part in lowered):
                        found.append("_".join(lowered))

            for token in parts[index:end]:
                if token.casefold() in _PROSE_SNAKE_PARTS:
                    flush()
                    group = []
                else:
                    group.append(token)
            flush()
            index = end
    return found


def extract_spellings(text: str) -> list[str]:
    kept_lines: list[str] = []
    for line in text.splitlines():
        if SECRET_ASSIGNMENT_RE.search(line) or MASK_RUN_RE.search(line):
            continue
        kept_lines.append(line)
    scrubbed = "\n".join(kept_lines)
    scrubbed = EMAIL_RE.sub(" ", scrubbed)
    scrubbed = URL_RE.sub(" ", scrubbed)
    scrubbed = JWT_RE.sub(" ", scrubbed)
    scrubbed = HEX_RE.sub(" ", scrubbed)
    tokens: list[str] = []
    for match in BACKTICK_IDENT_RE.finditer(scrubbed):
        inner = match.group(1)
        if _keep_spelling_token(inner):
            tokens.append(f"`{inner}`")
    tokens.extend(TIMES_TOKEN_RE.findall(scrubbed))
    tokens.extend(token for token in TOKEN_RE.findall(scrubbed) if _keep_spelling_token(token))
    existing = {_fold_lex(token) for token in tokens}
    for synthetic in _synthetic_snake_spellings(scrubbed):
        folded = _fold_lex(synthetic)
        if folded in existing or not _keep_spelling_token(synthetic):
            continue
        tokens.append(synthetic)
        existing.add(folded)
    return _bound_on_screen_spellings(tokens)


def _json_int(value: object) -> int | None:
    if isinstance(value, bool) or not isinstance(value, int):
        return None
    return value


def _reset_temp(file: Any) -> None:
    file.seek(0)
    file.truncate(0)


def _run_bounded_command(
    argv: list[str],
    *,
    timeout: float,
    limit: int,
    stdin_file: Any | None = None,
    stdout_file: Any,
) -> str:
    try:
        process = subprocess.Popen(
            argv,
            stdin=subprocess.DEVNULL if stdin_file is None else stdin_file,
            stdout=stdout_file,
            stderr=subprocess.DEVNULL,
            close_fds=True,
        )
    except OSError:
        return "invalid"
    try:
        process.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        process.kill()
        try:
            process.wait()
        except OSError:
            pass
        return "timeout"
    if process.returncode != 0:
        return "nonzero"
    try:
        size = os.fstat(stdout_file.fileno()).st_size
    except OSError:
        return "invalid"
    if size > limit:
        return "oversize"
    return "ok"


def _read_bounded_command_text(argv: list[str], *, timeout: float, limit: int) -> str:
    with tempfile.TemporaryFile("w+b") as stdout_file:
        status = _run_bounded_command(
            argv,
            timeout=timeout,
            limit=limit,
            stdout_file=stdout_file,
        )
        if status != "ok":
            return ""
        stdout_file.seek(0)
        raw = stdout_file.read()
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        return ""


def _grim_scale_args(width: int, height: int) -> list[str]:
    longest = max(width, height)
    if longest <= OCR_MAX_EDGE_PX:
        return []
    return ["-s", f"{OCR_MAX_EDGE_PX / longest:.3f}"]


def _window_size(window: dict[str, Any]) -> tuple[int, int] | None:
    size = window.get("size")
    if not isinstance(size, list) or len(size) != 2:
        return None
    width = _json_int(size[0])
    height = _json_int(size[1])
    if width is None or height is None or width <= 0 or height <= 0:
        return None
    return width, height


def _capture_geometry_png(window: dict[str, Any], png: Any) -> bool:
    at = window.get("at")
    size = _window_size(window)
    if not isinstance(at, list) or len(at) != 2 or size is None:
        return False
    x = _json_int(at[0])
    y = _json_int(at[1])
    width, height = size
    if x is None or y is None:
        return False
    status = _run_bounded_command(
        ["grim", "-g", f"{x},{y} {width}x{height}", *_grim_scale_args(width, height), "-"],
        timeout=CAPTURE_COMMAND_TIMEOUT_SECONDS,
        limit=MAX_SCREENSHOT_PNG_BYTES,
        stdout_file=png,
    )
    return status == "ok"


def _capture_focused_window_png(window: dict[str, Any], png: Any) -> bool:
    stable_id = window.get("stableId")
    size = _window_size(window)
    scale = _grim_scale_args(*(size if size is not None else (0, 0)))
    if isinstance(stable_id, str) and stable_id.strip():
        status = _run_bounded_command(
            ["grim", "-T", stable_id.strip(), *scale, "-"],
            timeout=CAPTURE_COMMAND_TIMEOUT_SECONDS,
            limit=MAX_SCREENSHOT_PNG_BYTES,
            stdout_file=png,
        )
        if status == "ok":
            return True
        if status in {"timeout", "oversize"}:
            return False
        _reset_temp(png)
    return _capture_geometry_png(window, png)


def _ocr_png(png: Any) -> str:
    png.seek(0)
    with tempfile.TemporaryFile("w+b") as text_file:
        status = _run_bounded_command(
            ["tesseract", "stdin", "stdout", "-l", "eng", "--oem", "1", "--psm", "6"],
            timeout=TESSERACT_TIMEOUT_SECONDS,
            limit=MAX_OCR_TEXT_BYTES,
            stdin_file=png,
            stdout_file=text_file,
        )
        if status != "ok":
            return ""
        text_file.seek(0)
        try:
            return text_file.read().decode("utf-8")
        except UnicodeDecodeError:
            return ""


class GrimTesseractSource:
    def __init__(self) -> None:
        self.window_class = ""

    def read_text(self) -> str:
        raw = _read_bounded_command_text(
            ["hyprctl", "activewindow", "-j"],
            timeout=CAPTURE_COMMAND_TIMEOUT_SECONDS,
            limit=MAX_ACTIVE_WINDOW_JSON_BYTES,
        )
        if not raw.strip():
            return ""
        try:
            window = json.loads(raw)
        except json.JSONDecodeError:
            return ""
        if not isinstance(window, dict) or not window:
            return ""
        self.window_class = str(window.get("class") or "")[:MAX_WINDOW_CLASS_CHARS]
        mapped = window.get("mapped", True)
        if mapped is False or mapped == 0:
            return ""
        folded = self.window_class.casefold()
        if folded == "hyprlock" or "greeter" in folded:
            return ""
        with tempfile.TemporaryFile("w+b") as png:
            if not _capture_focused_window_png(window, png):
                return ""
            return _ocr_png(png)


def on_screen_lexicon_path() -> Path:
    override = os.environ.get("VOXTYPE_ON_SCREEN_LEXICON", "").strip()
    if override:
        return Path(override)
    runtime = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
    return Path(runtime) / "voxtype" / "on-screen-lexicon.json"


def _load_on_screen_lexicon() -> list[str]:
    path = on_screen_lexicon_path()
    try:
        raw = path.read_bytes()
    except OSError:
        return []
    if len(raw) > MAX_ON_SCREEN_SPELLINGS_JSON_BYTES + 256:
        return []
    try:
        payload = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return []
    if not isinstance(payload, dict):
        return []
    recorded = payload.get("recorded_at")
    if not isinstance(recorded, (int, float)):
        return []
    if time.time() - float(recorded) > ON_SCREEN_LEXICON_TTL_SECONDS:
        return []
    return _bound_on_screen_spellings(payload.get("terms"))


def _store_on_screen_lexicon(terms: list[str]) -> None:
    path = on_screen_lexicon_path()
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        payload = json.dumps(
            {"recorded_at": int(time.time()), "terms": _bound_on_screen_spellings(terms)},
            ensure_ascii=False,
            separators=(",", ":"),
        )
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(payload)
    except OSError:
        return


def collect_on_screen_capture(source: ScreenTextSource | None = None) -> OnScreenCapture:
    persist = source is None
    window = ""
    try:
        adapter: ScreenTextSource = GrimTesseractSource() if persist else source
        live = extract_spellings(adapter.read_text())
        window_value = getattr(adapter, "window_class", "")
        window = window_value.strip()[:MAX_WINDOW_CLASS_CHARS] if isinstance(window_value, str) else ""
    except Exception:
        live = []
        window = ""
    cached = _load_on_screen_lexicon() if persist else []
    if live and persist:
        _store_on_screen_lexicon(live + cached)
    return OnScreenCapture(live=list(live), cached=list(cached), window=window)


def collect_on_screen_spellings(source: ScreenTextSource | None = None) -> list[str]:
    return collect_on_screen_capture(source).joiner


def _coerce_on_screen_capture(value: object) -> OnScreenCapture:
    if isinstance(value, OnScreenCapture):
        window = value.window.strip()[:MAX_WINDOW_CLASS_CHARS] if isinstance(value.window, str) else ""
        return OnScreenCapture(
            live=_bound_on_screen_spellings(value.live),
            cached=_bound_on_screen_spellings(value.cached),
            window=window,
        )
    if isinstance(value, list):
        terms = _bound_on_screen_spellings(value)
        return OnScreenCapture(live=terms, cached=[], window="")
    return OnScreenCapture(live=[], cached=[], window="")


def take_log_path() -> Path:
    override = os.environ.get("VOXTYPE_TAKE_LOG", "").strip()
    if override:
        return Path(override).expanduser()
    state = os.environ.get("XDG_STATE_HOME", "").strip()
    if state:
        return Path(state).expanduser() / "voxtype" / "refine-takes.jsonl"
    return Path.home() / ".local" / "state" / "voxtype" / "refine-takes.jsonl"


def take_log_transcripts_enabled() -> bool:
    value = os.environ.get("VOXTYPE_TAKE_LOG_TRANSCRIPTS", "").strip().lower()
    return value in {"1", "true", "yes"}


def append_take_log(
    *,
    raw: str,
    out: str,
    provider_id: str,
    live: list[str],
    window: str = "",
) -> None:
    try:
        _write_take_log_line(
            raw=raw,
            out=out,
            provider_id=provider_id,
            live=live,
            window=window,
        )
    except Exception:
        return


def _write_take_log_line(
    *,
    raw: str,
    out: str,
    provider_id: str,
    live: list[str],
    window: str,
) -> None:
    path = take_log_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    changed = out != raw
    record: dict[str, Any] = {
        "t": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "changed": changed,
        "window": window if isinstance(window, str) else "",
        "screen": _bound_on_screen_spellings(live),
        "raw_fold": _fold_lex(raw),
        "ident_shaped": _utterance_identifier_hint(raw) is not None,
    }
    if changed:
        record["out_fold"] = _fold_lex(out)
    record["provider"] = provider_id
    if take_log_transcripts_enabled():
        record["raw"] = raw
        record["out"] = out
    payload = json.dumps(record, ensure_ascii=False, separators=(",", ":")) + "\n"
    encoded = payload.encode("utf-8")
    if len(encoded) > MAX_TAKE_LOG_LINE_BYTES:
        return
    flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_CLOEXEC
    nofollow = getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags | nofollow, 0o600)
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return
        os.fchmod(fd, 0o600)
        os.write(fd, encoded)
    finally:
        os.close(fd)



def compose_system_prompt(prompt: str) -> str:
    return prompt.strip()


def lexical_hints_enabled() -> bool:
    value = os.environ.get("VOXTYPE_LEXICAL", "").strip().lower()
    if not value:
        value = os.environ.get("VOXTYPE_S1MINI_LEXICAL", "1").strip().lower()
    return value not in {"0", "false", "no", "off"}


def s1mini_lexical_enabled() -> bool:
    return lexical_hints_enabled()


def _fold_lex(text: str) -> str:
    return re.sub(r"[^0-9a-z]+", "", text.casefold().replace("×", "x"))


def _fold_transcript_tokens(tokens: list[str]) -> list[str]:
    folded = [_fold_lex(token) for token in tokens]
    adjusted: list[str] = []
    for item in folded:
        if item in _DIGIT_WORDS and adjusted and adjusted[-1] == "x":
            adjusted.append(_DIGIT_WORDS[item])
        else:
            adjusted.append(item)
    return adjusted


def _levenshtein(left: str, right: str, limit: int) -> int:
    if left == right:
        return 0
    if abs(len(left) - len(right)) > limit:
        return limit + 1
    if not left:
        return len(right)
    if not right:
        return len(left)
    if len(left) < len(right):
        left, right = right, left
    previous = list(range(len(right) + 1))
    for i, left_ch in enumerate(left, start=1):
        current = [i]
        row_min = i
        for j, right_ch in enumerate(right, start=1):
            insertion = current[j - 1] + 1
            deletion = previous[j] + 1
            substitution = previous[j - 1] + (left_ch != right_ch)
            value = min(insertion, deletion, substitution)
            current.append(value)
            if value < row_min:
                row_min = value
        if row_min > limit:
            return limit + 1
        previous = current
    return previous[-1]


def _near_miss(folded_span: str, folded_hint: str) -> bool:
    if not folded_span or not folded_hint:
        return False
    if folded_span == folded_hint:
        return True
    shortest = min(len(folded_span), len(folded_hint))
    if shortest < S1MINI_MIN_FOLD_CHARS:
        return False
    if abs(len(folded_span) - len(folded_hint)) > max(1, shortest // 4):
        return False
    limit = 1 if shortest < 8 else 2
    return _levenshtein(folded_span, folded_hint, limit) <= limit


def parse_dictionary_entries(dictionary: str) -> list[tuple[str, str]]:
    entries: list[tuple[str, str]] = []
    for line in dictionary.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        parts = DICTIONARY_ARROW_RE.split(stripped, maxsplit=1)
        if len(parts) == 2 and parts[0].strip() and parts[1].strip():
            entries.append((parts[0].strip(), parts[1].strip()))
        else:
            entries.append((stripped, stripped))
    return entries


def finish_refinement(
    text: str,
    dictionary: str = "",
    on_screen_spellings: list[str] | None = None,
) -> str:
    """Apply dictionary / on-screen near-miss respell to provider output."""
    if not text or not lexical_hints_enabled():
        return text
    return apply_lexical_hints(text, dictionary, on_screen_spellings)


def apply_lexical_hints(
    transcript: str,
    dictionary: str = "",
    on_screen_spellings: list[str] | None = None,
) -> str:
    """Replace near-miss transcript spans with dictionary or on-screen spellings.

    S1-mini does not consume Prism's JSON hint fields. This local pass is the
    only way those hints can respell a spoken near-miss before normalization.
    Unrelated or instruction-shaped terms that do not appear in the transcript
    are left untouched.
    """
    hints: list[tuple[str, str]] = list(parse_dictionary_entries(dictionary))
    for term in _bound_on_screen_spellings(on_screen_spellings):
        hints.append((term, term))
    if on_screen_spellings is not None:
        spoken_ident = _utterance_identifier_hint(transcript)
        if spoken_ident:
            folded = _fold_lex(spoken_ident)
            if not any(_fold_lex(written) == folded for _spoken, written in hints):
                hints.append((spoken_ident, spoken_ident))
    if not hints or not transcript:
        return transcript

    tokens = [(match.group(0), match.start(), match.end()) for match in TOKEN_RE.finditer(transcript)]
    if not tokens:
        return transcript

    folded_tokens = _fold_transcript_tokens([token for token, _start, _end in tokens])
    candidates: list[tuple[int, int, int, int, str]] = []

    for spoken, written in hints:
        folded_hint = _fold_lex(spoken)
        if not folded_hint:
            continue
        best: tuple[int, int, int, int, str] | None = None
        max_window = min(S1MINI_MAX_HINT_WINDOW, len(tokens))
        for start in range(len(tokens)):
            folded_span = ""
            for width in range(1, max_window + 1):
                end = start + width - 1
                if end >= len(tokens):
                    break
                folded_span += folded_tokens[end]
                if not folded_span:
                    continue
                if len(folded_span) > len(folded_hint) + max(1, len(folded_hint) // 4):
                    break
                if folded_span == folded_hint:
                    rank = 2
                elif _near_miss(folded_span, folded_hint):
                    rank = 1
                else:
                    continue
                span_start = tokens[start][1]
                span_end = tokens[end][2]
                candidate = (rank, width, -span_start, span_end, written)
                if best is None or candidate[:3] > best[:3]:
                    best = candidate
        if best is None:
            continue
        rank, width, neg_start, span_end, replacement = best
        span_start = -neg_start
        if transcript[span_start:span_end] == replacement:
            continue
        candidates.append((rank, width, span_start, span_end, replacement))

    # Exact matches beat near-misses; longer spans beat suffixes like
    # playerId inside canonicalPlayerId; longer written forms prefer
    # `ident` over ident; leftmost breaks remaining ties.
    candidates.sort(key=lambda item: (-item[0], -item[1], -len(item[4]), item[2]))
    occupied: list[tuple[int, int]] = []
    matches: list[tuple[int, int, int, str]] = []
    for _rank, width, span_start, span_end, replacement in candidates:
        if any(not (span_end <= left or span_start >= right) for left, right in occupied):
            continue
        occupied.append((span_start, span_end))
        matches.append((span_start, span_end, width, replacement))

    if not matches:
        return transcript
    matches.sort(key=lambda item: item[0], reverse=True)
    updated = transcript
    for span_start, span_end, _width, replacement in matches:
        updated = updated[:span_start] + replacement + updated[span_end:]
    return updated


def build_s1mini_input(transcript: str) -> str:
    return f"{S1MINI_CONTROL}\n{transcript}"


def build_refinement_input(
    raw: str,
    context: str = "",
    dictionary: str = "",
    on_screen_spellings: list[str] | None = None,
) -> str:
    payload = {}
    if context:
        payload["context_for_disambiguation_only"] = context
    spellings = [line.strip() for line in dictionary.splitlines() if line.strip()]
    if spellings:
        payload["preferred_spellings"] = spellings
    bounded_screen = _bound_on_screen_spellings(on_screen_spellings)
    if bounded_screen:
        payload["on_screen_spellings"] = bounded_screen
    payload["transcript"] = raw
    return json.dumps(payload, ensure_ascii=False, separators=(",", ":"))


def build_provider_request(
    provider: Provider,
    transcript: str,
    context: str = "",
    dictionary: str = "",
    on_screen_spellings: list[str] | None = None,
    system_prompt: str | None = None,
) -> tuple[str, str]:
    """Return (user, system) for the selected provider's trained input format."""
    if provider.id == "s1mini":
        hinted = transcript
        if lexical_hints_enabled():
            hinted = apply_lexical_hints(transcript, dictionary, on_screen_spellings)
        return build_s1mini_input(hinted), S1MINI_SYSTEM
    return (
        build_refinement_input(
            transcript,
            context,
            dictionary,
            on_screen_spellings=on_screen_spellings,
        ),
        compose_system_prompt(system_prompt if system_prompt is not None else DEFAULT_SYSTEM),
    )



def parse_refine_toml(text: str) -> dict[str, str | bool]:
    values: dict[str, str | bool] = {}
    in_top_level = True
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if re.match(r"^\[", stripped):
            in_top_level = False
            continue
        if not in_top_level:
            continue
        key, separator, raw = stripped.partition("=")
        if not separator:
            continue
        value = raw.split("#", 1)[0].strip()
        name = key.strip()
        if value == "true":
            values[name] = True
        elif value == "false":
            values[name] = False
        elif len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            values[name] = value[1:-1]
        else:
            values[name] = value
    return values


def load_selection(path: Path) -> tuple[Provider, str, bool]:
    provider_id = DEFAULT_PROVIDER
    model_override: str | None = None
    screen_context = False
    text = read_bounded_text(
        path,
        MAX_REFINE_CONFIG_BYTES,
        "refine config",
        missing_ok=True,
    )
    if text is not None:
        parsed = parse_refine_toml(text)
        if parsed.get("provider"):
            provider_id = str(parsed["provider"]).strip().lower()
        if parsed.get("model"):
            model_override = str(parsed["model"]).strip()
        screen_context = parsed.get("screen_context") is True
    env_provider = os.environ.get("VOXTYPE_REFINE_PROVIDER", "").strip().lower()
    if env_provider:
        provider_id = env_provider
    if provider_id not in PROVIDERS:
        raise RuntimeError(f"unknown refine provider {provider_id!r}")
    provider = PROVIDERS[provider_id]
    if provider.id == "local":
        override = os.environ.get("VOXTYPE_LOCAL_BASE_URL", "").strip()
        if override:
            provider = replace(provider, base_url=override)
    elif provider.id == "s1mini":
        override = os.environ.get("VOXTYPE_S1MINI_BASE_URL", "").strip()
        if override:
            provider = replace(provider, base_url=override)
    model = os.environ.get("VOXTYPE_REFINE_MODEL", "").strip() or model_override or provider.model
    return provider, model, screen_context


def write_refine_config(path: Path, provider_id: str) -> None:
    if provider_id not in PROVIDERS:
        raise RuntimeError(f"unknown refine provider {provider_id!r}")
    for _ in range(8):
        current = read_bounded_text(
            path,
            MAX_REFINE_CONFIG_BYTES,
            "refine config",
            missing_ok=True,
        )
        if current is None:
            updated = (
                "# Voxtype LLM refine provider. Switched by: voxtype-refine set <id>\n"
                f"provider = {json.dumps(provider_id)}\n"
            )
        else:
            updated = set_top_level_string(current, "provider", provider_id)
        if updated == current:
            return
        try:
            atomic_write_text(
                path,
                updated,
                MAX_REFINE_CONFIG_BYTES,
                "refine config",
                expected=current,
            )
            return
        except RuntimeError as error:
            if "changed concurrently" not in str(error):
                raise
    raise RuntimeError(f"refine config kept changing during update: {path}")


def set_top_level_string(text: str, key: str, value: str | None) -> str:
    """Losslessly set/remove one top-level TOML string assignment."""
    lines = text.splitlines(keepends=True)
    in_top_level = True
    for index, line in enumerate(lines):
        if re.match(r"^\s*\[[^]]+\]", line):
            in_top_level = False
        if not in_top_level or line.lstrip().startswith("#"):
            continue
        match = re.match(rf"^(\s*){re.escape(key)}\s*=.*?(\r?\n)?$", line)
        if not match:
            continue
        if value is None:
            del lines[index]
        else:
            newline = "\r\n" if line.endswith("\r\n") else "\n" if line.endswith("\n") else ""
            lines[index] = f"{match.group(1)}{key} = {json.dumps(value)}{newline}"
        return "".join(lines)

    if value is None:
        return text
    insert_at = next(
        (index for index, line in enumerate(lines) if re.match(r"^\s*\[[^]]+\]", line)),
        len(lines),
    )
    prefix = "" if insert_at == 0 or lines[insert_at - 1].endswith(("\n", "\r\n")) else "\n"
    lines.insert(insert_at, f"{prefix}{key} = {json.dumps(value)}\n")
    return "".join(lines)


def set_top_level_bool(text: str, key: str, value: bool) -> str:
    """Losslessly set one top-level TOML boolean assignment."""
    literal = "true" if value else "false"
    lines = text.splitlines(keepends=True)
    in_top_level = True
    for index, line in enumerate(lines):
        if re.match(r"^\s*\[[^]]+\]", line):
            in_top_level = False
        if not in_top_level or line.lstrip().startswith("#"):
            continue
        match = re.match(rf"^(\s*){re.escape(key)}\s*=.*?(\r?\n)?$", line)
        if not match:
            continue
        newline = "\r\n" if line.endswith("\r\n") else "\n" if line.endswith("\n") else ""
        lines[index] = f"{match.group(1)}{key} = {literal}{newline}"
        return "".join(lines)

    insert_at = next(
        (index for index, line in enumerate(lines) if re.match(r"^\s*\[[^]]+\]", line)),
        len(lines),
    )
    prefix = "" if insert_at == 0 or lines[insert_at - 1].endswith(("\n", "\r\n")) else "\n"
    lines.insert(insert_at, f"{prefix}{key} = {literal}\n")
    return "".join(lines)



def strip_output(text: str) -> str:
    text = THINK_RE.sub("", text).strip()
    if len(text) >= 2 and text[0] == text[-1] and text[0] in "\"'":
        text = text[1:-1].strip()
    return text


def openai_message_text(payload: dict[str, Any]) -> str:
    choices = payload.get("choices") or []
    if not choices:
        return ""
    message = choices[0].get("message") or {}
    return strip_output(str(message.get("content") or ""))


def anthropic_message_text(payload: dict[str, Any]) -> str:
    chunks: list[str] = []
    for block in payload.get("content") or []:
        if isinstance(block, dict) and block.get("type") == "text":
            chunks.append(str(block.get("text") or ""))
    return strip_output("".join(chunks))


def collect_codex_sse(raw: bytes) -> str:
    texts: list[str] = []
    for event in raw.replace(b"\r\n", b"\n").split(b"\n\n"):
        for line in event.split(b"\n"):
            if not line.startswith(b"data:"):
                continue
            data = line[5:].strip()
            if data in (b"", b"[DONE]"):
                continue
            try:
                payload = json.loads(data)
            except json.JSONDecodeError:
                continue
            if payload.get("type") == "response.output_text.delta":
                texts.append(str(payload.get("delta") or ""))
    return strip_output("".join(texts))


def expiry_seconds(expires: Any) -> float | None:
    if not isinstance(expires, (int, float)):
        return None
    value = float(expires)
    if value > 10_000_000_000:
        value /= 1000.0
    return value


def credential_database_path() -> Path:
    override = os.environ.get("VOXTYPE_OMP_AGENT_DB", "")
    return Path(override).expanduser() if override else Path.home() / ".omp" / "agent" / "agent.db"


def _credential_database_identity(path: Path) -> tuple[int, int, int] | None:
    """Return a bounded regular-file identity without following the path."""
    try:
        metadata = os.lstat(path)
    except FileNotFoundError:
        return None
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
        raise RuntimeError("unsafe credential database")
    if metadata.st_size > MAX_CREDENTIAL_DB_BYTES:
        raise RuntimeError("credential database is unexpectedly large")
    return metadata.st_dev, metadata.st_ino, metadata.st_size


def _assert_credential_database_unchanged(
    path: Path,
    expected: tuple[int, int, int],
) -> None:
    if _credential_database_identity(path) != expected:
        raise RuntimeError("credential database changed while reading")


def _credential_missing(missing_ok: bool) -> None:
    if missing_ok:
        return None
    raise RuntimeError("no OhMyPi login for the selected provider; run omp /login")


def _load_credential_payload(
    provider_id: str,
    *,
    missing_ok: bool,
) -> dict[str, Any] | None:
    """Read one bounded credential object from a stable read-only database."""
    path = credential_database_path()
    identity = _credential_database_identity(path)
    if identity is None:
        return _credential_missing(missing_ok)

    absolute_path = os.path.abspath(os.fspath(path))
    uri = f"file:{urllib.parse.quote(absolute_path, safe='/')}?mode=ro"
    try:
        connection = sqlite3.connect(uri, uri=True)
    except sqlite3.Error as error:
        _assert_credential_database_unchanged(path, identity)
        raise RuntimeError("could not read the OhMyPi credential database") from error

    try:
        _assert_credential_database_unchanged(path, identity)
        try:
            row = connection.execute(
                "select substr(cast(data as blob), 1, ?) "
                "from auth_credentials where provider = ? limit 1",
                (MAX_CREDENTIAL_JSON_BYTES + 1, provider_id),
            ).fetchone()
        except sqlite3.Error as error:
            _assert_credential_database_unchanged(path, identity)
            raise RuntimeError("could not read the OhMyPi credential database") from error
        _assert_credential_database_unchanged(path, identity)
    finally:
        connection.close()

    if row is None or row[0] is None:
        return _credential_missing(missing_ok)
    raw = row[0]
    if isinstance(raw, memoryview):
        encoded = raw.tobytes()
    elif isinstance(raw, bytes):
        encoded = raw
    elif isinstance(raw, str):
        encoded = raw.encode("utf-8")
    else:
        raise RuntimeError("OhMyPi credential data has an invalid shape")
    if len(encoded) > MAX_CREDENTIAL_JSON_BYTES:
        raise RuntimeError("OhMyPi credential data is too large")
    try:
        data = json.loads(encoded.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise RuntimeError("OhMyPi credential data is invalid") from error
    if not isinstance(data, dict):
        raise RuntimeError("OhMyPi credential data has an invalid shape")
    return data


def load_oauth(provider_id: str, *, missing_ok: bool = False) -> dict[str, Any] | None:
    data = _load_credential_payload(provider_id, missing_ok=missing_ok)
    if data is None:
        return None
    access = data.get("access")
    if access is None or (isinstance(access, str) and not access.strip()):
        if missing_ok:
            return None
        raise RuntimeError("OhMyPi credential is missing an access token")
    if not isinstance(access, str):
        raise RuntimeError("OhMyPi credential data has an invalid shape")
    return data


def oauth_available(provider_id: str) -> bool:
    """Return readiness without exposing a credential object to the caller."""
    return load_oauth(provider_id, missing_ok=True) is not None


class RefuseProviderRedirects(urllib.request.HTTPRedirectHandler):
    """Fail closed before urllib can copy secrets to a redirect target."""

    def redirect_request(
        self,
        request: urllib.request.Request,
        response: Any,
        code: int,
        message: str,
        headers: Any,
        redirected_url: str,
    ) -> None:
        del redirected_url
        try:
            response.close()
        finally:
            raise urllib.error.HTTPError(
                request.full_url,
                code,
                f"provider redirect refused: {message}",
                headers,
                None,
            )


def open_provider_request(request: urllib.request.Request, timeout: float) -> Any:
    """Open one provider request without process-global redirect handling."""
    opener = urllib.request.build_opener(RefuseProviderRedirects())
    return opener.open(request, timeout=timeout)


def refresh_oauth(omp_provider: str, cred: dict[str, Any]) -> str:
    access = str(cred.get("access") or "")
    refresh = str(cred.get("refresh") or "")
    expires = expiry_seconds(cred.get("expires"))
    if expires is not None and expires - time.time() > 90:
        return access
    if not refresh:
        return access

    if omp_provider == "xai-oauth":
        url = "https://auth.x.ai/oauth2/token"
        body = urllib.parse.urlencode(
            {
                "grant_type": "refresh_token",
                "refresh_token": refresh,
                "client_id": "b1a00492-073a-47ea-816f-4c329264a828",
            }
        ).encode()
        headers = {"Content-Type": "application/x-www-form-urlencoded"}
    elif omp_provider == "anthropic":
        url = "https://api.anthropic.com/v1/oauth/token"
        body = json.dumps(
            {
                "grant_type": "refresh_token",
                "refresh_token": refresh,
                "client_id": "9d1c250a-e61b-44d9-88ed-5944d1962f5e",
            }
        ).encode()
        headers = {"Content-Type": "application/json"}
    elif omp_provider == "openai-codex":
        url = "https://auth.openai.com/oauth/token"
        body = urllib.parse.urlencode(
            {
                "grant_type": "refresh_token",
                "refresh_token": refresh,
                "client_id": "app_EMoamEEZ73f0CkXaXp7hrann",
            }
        ).encode()
        headers = {"Content-Type": "application/x-www-form-urlencoded"}
    else:
        return access

    req = urllib.request.Request(url, data=body, headers=headers, method="POST")
    try:
        with open_provider_request(req, timeout=15) as resp:
            payload = json.loads(read_bounded_response(resp).decode("utf-8"))
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, UnicodeDecodeError, OSError, RuntimeError):
        return access
    token = payload.get("access_token")
    return str(token) if token else access


def read_bounded_response(response: Any, limit: int = MAX_NETWORK_RESPONSE_BYTES) -> bytes:
    """Read a provider response with a hard ceiling, regardless of headers."""
    content_length = None
    headers = getattr(response, "headers", None)
    if headers is not None:
        try:
            raw_length = headers.get("Content-Length")
            content_length = int(raw_length) if raw_length is not None else None
        except (TypeError, ValueError):
            content_length = None
    if content_length is not None and content_length > limit:
        raise RuntimeError("refine provider response exceeded the byte limit")

    chunks: list[bytes] = []
    collected = 0
    while collected <= limit:
        chunk = response.read(min(NETWORK_READ_CHUNK_BYTES, limit + 1 - collected))
        if not chunk:
            break
        chunks.append(chunk)
        collected += len(chunk)
    if collected > limit:
        raise RuntimeError("refine provider response exceeded the byte limit")
    return b"".join(chunks)


def http_json(url: str, headers: dict[str, str], payload: dict[str, Any], timeout: float) -> dict[str, Any]:
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers=headers,
        method="POST",
    )
    with open_provider_request(req, timeout=timeout) as resp:
        decoded = json.loads(read_bounded_response(resp).decode("utf-8"))
    if not isinstance(decoded, dict):
        raise RuntimeError("refine provider returned an invalid JSON response")
    return decoded


def http_bytes(url: str, headers: dict[str, str], payload: dict[str, Any], timeout: float) -> bytes:
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers=headers,
        method="POST",
    )
    with open_provider_request(req, timeout=timeout) as resp:
        return read_bounded_response(resp)


def complete(provider: Provider, model: str, user: str, system: str) -> str:
    timeout = float(os.environ.get("VOXTYPE_LLM_TIMEOUT", "25"))
    if provider.api == "openai-completions":
        headers = {"Content-Type": "application/json"}
        if provider.omp_provider:
            token = refresh_oauth(provider.omp_provider, load_oauth(provider.omp_provider))
            headers["Authorization"] = f"Bearer {token}"
        payload: dict[str, Any] = {
            "model": model,
            "temperature": 0 if provider.id == "s1mini" else 0.1,
            "max_tokens": 2048,
            "messages": [
                {"role": "system", "content": system},
                {"role": "user", "content": user},
            ],
        }
        if provider.id in {"local", "s1mini"}:
            payload["chat_template_kwargs"] = {"enable_thinking": False}
        data = http_json(f"{provider.base_url.rstrip('/')}/chat/completions", headers, payload, timeout)
        return openai_message_text(data)

    if provider.api == "anthropic-messages":
        token = refresh_oauth("anthropic", load_oauth("anthropic"))
        data = http_json(
            f"{provider.base_url.rstrip('/')}/v1/messages",
            {
                "Authorization": f"Bearer {token}",
                "Content-Type": "application/json",
                "anthropic-version": "2023-06-01",
            },
            {
                "model": model,
                "max_tokens": 2048,
                "system": system,
                "messages": [{"role": "user", "content": user}],
            },
            timeout,
        )
        return anthropic_message_text(data)

    if provider.api == "openai-codex-responses":
        cred = load_oauth("openai-codex")
        token = refresh_oauth("openai-codex", cred)
        headers = {
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
            "Accept": "text/event-stream",
        }
        account = cred.get("accountId")
        if account:
            headers["ChatGPT-Account-Id"] = str(account)
        raw = http_bytes(
            provider.base_url,
            headers,
            {
                "model": model,
                "instructions": system,
                "input": [{"role": "user", "content": [{"type": "input_text", "text": user}]}],
                "store": False,
                "stream": True,
            },
            timeout,
        )
        return collect_codex_sse(raw)

    raise RuntimeError(f"unsupported refine api {provider.api}")



def refine_text(raw: str) -> str:
    if not raw.strip():
        return raw
    provider, model, screen_context = load_selection(refine_config_path())
    live: list[str] | None = None
    joiner: list[str] | None = None
    window = ""
    if screen_context:
        with ThreadPoolExecutor(max_workers=1) as pool:
            future = pool.submit(collect_on_screen_capture)
            context = os.environ.get("VOXTYPE_CONTEXT", "").strip()
            dictionary = load_dictionary(dictionary_path())
            system = compose_system_prompt(load_system_prompt(prompt_path()))
            capture = _coerce_on_screen_capture(future.result())
        live = capture.live
        joiner = capture.joiner
        window = capture.window
    else:
        context = os.environ.get("VOXTYPE_CONTEXT", "").strip()
        dictionary = load_dictionary(dictionary_path())
        system = compose_system_prompt(load_system_prompt(prompt_path()))
    provider_spellings = joiner if provider.id == "s1mini" else live
    user, request_system = build_provider_request(
        provider,
        raw,
        context,
        dictionary,
        on_screen_spellings=provider_spellings,
        system_prompt=system,
    )
    cleaned = complete(provider, model, user, request_system)

    if not cleaned:
        if provider.id == "s1mini":
            result = "\n" if raw.endswith("\n") else ""
            append_take_log(
                raw=raw,
                out=result,
                provider_id=provider.id,
                live=live or [],
                window=window,
            )
            return result
        raise RuntimeError("refine provider returned empty text")
    cleaned = finish_refinement(cleaned, dictionary, joiner)
    if raw.endswith("\n") and not cleaned.endswith("\n"):
        cleaned += "\n"
    append_take_log(
        raw=raw,
        out=cleaned,
        provider_id=provider.id,
        live=live or [],
        window=window,
    )
    return cleaned



_CAMEL_BOUNDARY_RE = re.compile(r"([a-z0-9])([A-Z])")
_ACRONYM_BOUNDARY_RE = re.compile(r"([A-Z]+)([A-Z][a-z])")
_HARVEST_SLUG_RE = re.compile(r"[^A-Za-z0-9]+")


def _is_omarchy_plugin_tree(path: Path) -> bool:
    parts = path.parts
    for index, part in enumerate(parts):
        if part == "omarchy" and index + 1 < len(parts) and parts[index + 1] == "plugins":
            return True
    return False


def _skip_harvest_name(name: str) -> bool:
    lowered = name.casefold()
    if lowered.startswith(".env") or name.startswith("id_"):
        return True
    if lowered in {"auth.json", "state.db"}:
        return True
    suffix = Path(name).suffix.casefold()
    return suffix in {".pem", ".key", ".sqlite", ".sqlite3", ".db"}


def spoken_identifier_split(ident: str) -> str:
    text = ident.strip().strip("`")
    if not text:
        return ""
    text = text.replace("_", " ").replace("-", " ")
    text = _ACRONYM_BOUNDARY_RE.sub(r"\1 \2", text)
    text = _CAMEL_BOUNDARY_RE.sub(r"\1 \2", text)
    return re.sub(r"\s+", " ", text).strip().lower()


def _stable_harvest_name(ident: str) -> str:
    slug = _HARVEST_SLUG_RE.sub("_", ident).strip("_").casefold()
    return slug or "token"


def _sentence_transcript(spoken: str) -> str:
    spoken = spoken.strip()
    if not spoken:
        return ""
    if not spoken.endswith("."):
        spoken += "."
    return spoken[:1].upper() + spoken[1:]


def _core_without_added_period(text: str, ident: str) -> str:
    stripped = text.strip()
    if stripped.endswith(".") and not ident.endswith("."):
        return stripped[:-1]
    return stripped


def mint_factory_a_case(ident: str) -> dict[str, Any] | None:
    spoken = spoken_identifier_split(ident)
    if not spoken or " " not in spoken:
        return None
    transcript = _sentence_transcript(spoken)
    joined = apply_lexical_hints(transcript, on_screen_spellings=[ident])
    if _core_without_added_period(joined, ident) == ident:
        return None
    expected = ident + "." if transcript.endswith(".") and not ident.endswith(".") else ident
    return {
        "name": f"harvest_{_stable_harvest_name(ident)}",
        "on_screen_spellings": [ident],
        "transcript": transcript,
        "expected": expected,
    }


def mint_factory_b_case(record: dict[str, Any]) -> dict[str, Any] | None:
    if record.get("changed") is not False or record.get("ident_shaped") is not True:
        return None
    raw = record.get("raw")
    if not isinstance(raw, str) or not raw.strip():
        return None
    screen_raw = record.get("screen")
    if not isinstance(screen_raw, list):
        return None
    screen = [item for item in screen_raw if isinstance(item, str)]
    raw_fold = record.get("raw_fold")
    if not isinstance(raw_fold, str) or not raw_fold:
        raw_fold = _fold_lex(raw)
    utterance = _utterance_identifier_hint(raw)
    utterance_fold = _fold_lex(utterance) if utterance else ""
    expected_token = None
    for token in screen:
        folded = _fold_lex(token)
        if folded and (folded == raw_fold or (utterance_fold and folded == utterance_fold)):
            expected_token = token
            break
    if expected_token is None:
        return None
    expected = expected_token
    if raw.rstrip().endswith(".") and not expected.endswith("."):
        expected += "."
    joined = apply_lexical_hints(raw, on_screen_spellings=screen)
    if joined == expected or _core_without_added_period(joined, expected_token) == expected_token:
        return None
    return {
        "name": f"harvest_{_stable_harvest_name(expected_token)}",
        "on_screen_spellings": [expected_token],
        "transcript": raw.rstrip("\n"),
        "expected": expected,
    }


def _load_eval_cases(path: Path) -> list[dict[str, Any]]:
    try:
        if path.is_symlink() or not path.is_file():
            return []
        raw = path.read_bytes()
    except OSError:
        return []
    if len(raw) > MAX_HARVEST_INBOX_BYTES:
        return []
    try:
        payload = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return []
    if not isinstance(payload, list):
        return []
    return [item for item in payload if isinstance(item, dict)]


def _eval_case_key(case: dict[str, Any]) -> tuple[str, str]:
    return (str(case.get("transcript", "")), str(case.get("expected", "")))


def _merge_inbox(
    existing: list[dict[str, Any]],
    minted: list[dict[str, Any]],
    blocked_names: set[str],
) -> list[dict[str, Any]]:
    names = {str(case.get("name")) for case in existing if isinstance(case.get("name"), str)}
    names |= blocked_names
    pairs = {_eval_case_key(case) for case in existing}
    merged = list(existing)
    for case in minted:
        name = case.get("name")
        if not isinstance(name, str) or name in names:
            continue
        key = _eval_case_key(case)
        if key in pairs:
            continue
        names.add(name)
        pairs.add(key)
        merged.append(case)
    return merged


def _git_tracked_basenames(root: Path) -> list[str]:
    try:
        completed = subprocess.run(
            ["git", "-C", str(root), "ls-files", "-z"],
            check=False,
            capture_output=True,
            timeout=GIT_LS_FILES_TIMEOUT_SECONDS,
        )
    except (OSError, subprocess.TimeoutExpired):
        return []
    if completed.returncode != 0 or not completed.stdout:
        return []
    names: list[str] = []
    seen: set[str] = set()
    for raw in completed.stdout.split(b"\0"):
        if not raw:
            continue
        try:
            rel = raw.decode("utf-8")
        except UnicodeDecodeError:
            continue
        base = Path(rel).name
        if not base or _skip_harvest_name(base) or base in seen:
            continue
        seen.add(base)
        names.append(base)
    return names


_SOURCE_SUFFIXES = {
    ".c",
    ".cc",
    ".cpp",
    ".go",
    ".h",
    ".java",
    ".js",
    ".jsx",
    ".kt",
    ".py",
    ".pyi",
    ".qml",
    ".rb",
    ".rs",
    ".toml",
    ".ts",
    ".tsx",
}


def _identifiers_from_basename(name: str) -> list[str]:
    tokens: list[str] = []
    seen: set[str] = set()
    path = Path(name)
    chunk = path.stem if path.suffix.casefold() in _SOURCE_SUFFIXES and path.stem else name
    for token in extract_spellings(chunk):
        if token in seen:
            continue
        seen.add(token)
        tokens.append(token)
    return tokens


def _iter_session_jsonl(sessions_dir: Path) -> list[Path]:
    try:
        root = sessions_dir.expanduser().resolve()
    except OSError:
        return []
    if not root.is_dir():
        return []
    found: list[Path] = []
    try:
        for path in root.rglob("*.jsonl"):
            if len(found) >= MAX_SESSION_HARVEST_FILES:
                break
            try:
                if path.is_symlink() or not path.is_file():
                    continue
            except OSError:
                continue
            if _skip_harvest_name(path.name) or path.suffix.casefold() != ".jsonl":
                continue
            found.append(path)
    except OSError:
        return []
    return found


def _read_session_jsonl_text(path: Path) -> str:
    try:
        if path.stat().st_size > MAX_SESSION_HARVEST_FILE_BYTES:
            return ""
    except OSError:
        return ""
    lines: list[str] = []
    try:
        with path.open("r", encoding="utf-8", errors="replace") as handle:
            for index, line in enumerate(handle):
                if index >= MAX_SESSION_HARVEST_LINES:
                    break
                lines.append(line)
    except OSError:
        return ""
    return "".join(lines)


def _iter_take_log_records(path: Path) -> list[dict[str, Any]]:
    try:
        if path.is_symlink() or not path.is_file():
            return []
    except OSError:
        return []
    records: list[dict[str, Any]] = []
    try:
        with path.open("r", encoding="utf-8") as handle:
            for index, line in enumerate(handle):
                if index >= MAX_TAKE_LOG_HARVEST_LINES:
                    break
                stripped = line.strip()
                if not stripped:
                    continue
                try:
                    payload = json.loads(stripped)
                except json.JSONDecodeError:
                    continue
                if isinstance(payload, dict):
                    records.append(payload)
    except OSError:
        return []
    return records


def cmd_harvest_evals(root: Path | None = None, sessions_dirs: list[Path] | None = None) -> int:
    base = Path(__file__).resolve().parent.parent if root is None else Path(root).expanduser()
    try:
        base = base.resolve()
    except OSError as error:
        print(f"harvest-evals: cannot resolve root: {error}", file=sys.stderr)
        return 2
    if _is_omarchy_plugin_tree(base):
        print("harvest-evals: refusing to write the Omarchy plugin tree", file=sys.stderr)
        return 2
    product = (base / HARVEST_PRODUCT_RELATIVE).resolve()
    inbox = (base / HARVEST_INBOX_RELATIVE).resolve()
    if inbox == product:
        print("harvest-evals: refusing to write the product corpus", file=sys.stderr)
        return 2
    blocked = {
        str(case.get("name"))
        for case in _load_eval_cases(product)
        if isinstance(case.get("name"), str)
    }
    existing = _load_eval_cases(inbox)
    minted: list[dict[str, Any]] = []
    seen_idents: set[str] = set()
    for basename in _git_tracked_basenames(base):
        for ident in _identifiers_from_basename(basename):
            if ident in seen_idents:
                continue
            seen_idents.add(ident)
            case = mint_factory_a_case(ident)
            if case is not None:
                minted.append(case)
    for sessions_dir in sessions_dirs or []:
        for path in _iter_session_jsonl(sessions_dir):
            text = _read_session_jsonl_text(path)
            if not text:
                continue
            for ident in extract_spellings(text):
                if ident in seen_idents:
                    continue
                seen_idents.add(ident)
                case = mint_factory_a_case(ident)
                if case is not None:
                    minted.append(case)
    take_records = _iter_take_log_records(take_log_path())
    if any(isinstance(record.get("raw"), str) and str(record.get("raw")).strip() for record in take_records):
        for record in take_records:
            case = mint_factory_b_case(record)
            if case is not None:
                minted.append(case)
    merged = _merge_inbox(existing, minted, blocked)
    try:
        inbox.parent.mkdir(parents=True, exist_ok=True)
        payload = json.dumps(merged, ensure_ascii=False, indent=2) + "\n"
        atomic_write_text(inbox, payload, MAX_HARVEST_INBOX_BYTES, "eval inbox")
    except (OSError, RuntimeError) as error:
        print(f"harvest-evals: failed to write inbox: {error}", file=sys.stderr)
        return 1
    added = len(merged) - len(existing)
    print(f"harvest-evals: wrote {inbox} ({len(merged)} cases, {max(added, 0)} new)")
    return 0


def cmd_list() -> int:
    selected, _, _ = load_selection(refine_config_path())
    for provider in PROVIDERS.values():
        mark = "*" if provider.id == selected.id else " "
        print(f"{mark} {provider.id:<10} {provider.label}  [{provider.model}]")
    return 0


def cmd_status() -> int:
    provider, model, screen_context = load_selection(refine_config_path())
    print(f"provider={provider.id}")
    print(f"model={model}")
    print(f"screen_context={'true' if screen_context else 'false'}")
    print(f"label={provider.label}")
    print(f"config={refine_config_path()}")
    print(f"prompt={prompt_path()}")
    print(f"dictionary={dictionary_path()}")

    return 0


def cmd_set(provider_id: str) -> int:
    write_refine_config(refine_config_path(), provider_id)
    provider, model, _ = load_selection(refine_config_path())
    print(f"refine provider set to {provider.id} ({model})")
    return 0


def cmd_prompt() -> int:
    provider, _model, _screen = load_selection(refine_config_path())
    path = ensure_prompt_file(prompt_path())
    if provider.id == "s1mini":
        print(f"provider={provider.id}")
        print("S1-mini by Superwhisper uses a fixed system prompt; refine-prompt.md is not sent.")
        print(f"dictionary={dictionary_path()}")
        print("---")
        print(S1MINI_SYSTEM, end="\n")
        return 0
    system = compose_system_prompt(load_system_prompt(path))
    print(f"prompt={path}")
    print(f"dictionary={dictionary_path()}")
    print("---")
    print(system, end="" if system.endswith("\n") else "\n")
    return 0


def cmd_edit_prompt() -> int:
    path = ensure_prompt_file(prompt_path())
    editor = os.environ.get("EDITOR") or os.environ.get("VISUAL") or "nvim"
    return subprocess.call([editor, str(path)])


def cmd_dictionary() -> int:
    path = dictionary_path()
    text = load_dictionary(path)
    print(f"dictionary={path}")
    print("---")
    if not text:
        print("(empty)")
        return 0
    print(text, end="" if text.endswith("\n") else "\n")
    return 0


def cmd_edit_dictionary() -> int:
    path = ensure_dictionary_file(dictionary_path())
    editor = os.environ.get("EDITOR") or os.environ.get("VISUAL") or "nvim"
    return subprocess.call([editor, str(path)])



def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    sub = result.add_subparsers(dest="action")
    sub.add_parser("list", help="list refine providers")
    sub.add_parser("status", help="show the active refine provider")
    set_cmd = sub.add_parser("set", help="switch the refine provider")
    set_cmd.add_argument("provider", choices=sorted(PROVIDERS))
    sub.add_parser("prompt", help="print the assembled system prompt")
    sub.add_parser("edit-prompt", help="open the system prompt in $EDITOR")
    sub.add_parser("dictionary", help="print the dictionary path and terms")
    sub.add_parser("edit-dictionary", help="open the dictionary in $EDITOR")
    harvest = sub.add_parser(
        "harvest-evals",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        help="mint joiner evals into tests/fixtures/refinement-eval.inbox.json",
        description=(
            "Work-repo command. Writes tests/fixtures/refinement-eval.inbox.json only.\n"
            "Never writes tests/fixtures/refinement-eval.json or the Omarchy plugin tree.\n"
            "\n"
            "Factory A: git ls-files basenames under --root (skip .env*, id_*, *.pem,\n"
            "*.key, auth.json), plus optional --sessions-dir jsonl (**/chat_history.jsonl\n"
            "and **/*.jsonl, 2 MiB and line-capped; never state.db, auth.json, or *.sqlite).\n"
            "Invent a spoken split, run apply_lexical_hints, and mint when the joiner misses.\n"
            "Does not walk ~/.hermes or ~/.claude unless you pass --sessions-dir.\n"
            "\n"
            "Factory B: read VOXTYPE_TAKE_LOG or $XDG_STATE_HOME/voxtype/refine-takes.jsonl.\n"
            "Mint only when changed is false, ident_shaped is true, a live screen token has\n"
            "the same fold as the utterance, and apply_lexical_hints does not already emit\n"
            "that on-screen token. Skip factory B when the take log has no raw/out\n"
            "(default take log redacts transcripts; set VOXTYPE_TAKE_LOG_TRANSCRIPTS=1 to keep them).\n"
            "\n"
            "Does not implement record-start capture."
        ),
    )
    harvest.add_argument(
        "--root",
        type=Path,
        default=None,
        help="git work tree whose tests/fixtures inbox is written (default: parent of scripts/)",
    )
    harvest.add_argument(
        "--sessions-dir",
        action="append",
        default=None,
        type=Path,
        metavar="DIR",
        help="optional jsonl tree to harvest (repeatable; off by default)",
    )

    return result


def read_bounded_stdin(limit: int = MAX_TRANSCRIPT_BYTES) -> str:
    raw = sys.stdin.buffer.read(limit + 1)
    if len(raw) > limit:
        raise RuntimeError("transcript exceeded the byte limit")
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError as error:
        raise RuntimeError("transcript is not valid UTF-8") from error



def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if argv:
        args = parser().parse_args(argv)
        if args.action == "list":
            return cmd_list()
        if args.action == "status":
            return cmd_status()
        if args.action == "set":
            return cmd_set(args.provider)
        if args.action == "prompt":
            return cmd_prompt()
        if args.action == "edit-prompt":
            return cmd_edit_prompt()
        if args.action == "dictionary":
            return cmd_dictionary()
        if args.action == "edit-dictionary":
            return cmd_edit_dictionary()
        if args.action == "harvest-evals":
            return cmd_harvest_evals(root=args.root, sessions_dirs=args.sessions_dir)

        return 2
    try:
        sys.stdout.write(refine_text(read_bounded_stdin()))
        return 0
    except (OSError, RuntimeError, urllib.error.URLError, TimeoutError, json.JSONDecodeError, sqlite3.Error):
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
