def xdg_path(env_name: str, fallback: Path) -> Path:
    value = os.environ.get(env_name, "")
    return Path(value).expanduser() if value else fallback


def path_entry_exists(path: Path) -> bool:
    """Return whether a directory entry exists without following its target."""
    try:
        os.lstat(path)
        return True
    except FileNotFoundError:
        return False


def read_bounded_text(
    path: Path,
    limit: int,
    label: str,
    *,
    missing_ok: bool = False,
) -> str | None:
    """Read one UTF-8 regular file without following the final path component."""
    nofollow = getattr(os, "O_NOFOLLOW", 0)
    if nofollow == 0:
        raise RuntimeError(f"O_NOFOLLOW is required for {label} access")
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | nofollow)
    except FileNotFoundError:
        if missing_ok:
            return None
        raise RuntimeError(f"{label} not found: {path}") from None
    except OSError as error:
        raise RuntimeError(f"Refusing unsafe {label} path: {path}") from error

    try:
        return _read_bounded_descriptor(descriptor, limit, label, str(path))
    finally:
        os.close(descriptor)


def _read_bounded_descriptor(descriptor: int, limit: int, label: str, display_path: str) -> str:
    metadata = os.fstat(descriptor)
    if not stat.S_ISREG(metadata.st_mode):
        raise RuntimeError(f"{label} is not a regular file: {display_path}")
    if metadata.st_size > limit:
        raise RuntimeError(f"{label} is unexpectedly large: {display_path}")

    chunks: list[bytes] = []
    collected = 0
    while collected <= limit:
        chunk = os.read(descriptor, min(64 * 1024, limit + 1 - collected))
        if not chunk:
            break
        chunks.append(chunk)
        collected += len(chunk)
    if collected > limit:
        raise RuntimeError(f"{label} grew beyond the byte limit: {display_path}")
    try:
        return b"".join(chunks).decode("utf-8")
    except UnicodeDecodeError as error:
        raise RuntimeError(f"{label} is not valid UTF-8: {display_path}") from error


def _read_bounded_text_at(directory: int, name: str, limit: int, label: str) -> str:
    nofollow = getattr(os, "O_NOFOLLOW", 0)
    if nofollow == 0:
        raise RuntimeError(f"O_NOFOLLOW is required for {label} access")
    try:
        descriptor = os.open(
            name,
            os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | nofollow,
            dir_fd=directory,
        )
    except OSError as error:
        raise RuntimeError(f"Refusing unsafe {label} quarantine") from error
    try:
        return _read_bounded_descriptor(descriptor, limit, label, name)
    finally:
        os.close(descriptor)


def _open_parent_directory(path: Path) -> int:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    nofollow = getattr(os, "O_NOFOLLOW", 0)
    if nofollow == 0:
        raise RuntimeError("O_NOFOLLOW is required for settings writes")
    try:
        descriptor = os.open(
            path.parent,
            os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | nofollow,
        )
    except OSError as error:
        raise RuntimeError(f"Refusing unsafe settings directory: {path.parent}") from error
    if not stat.S_ISDIR(os.fstat(descriptor).st_mode):
        os.close(descriptor)
        raise RuntimeError(f"Settings parent is not a directory: {path.parent}")
    return descriptor


def _write_all(descriptor: int, data: bytes) -> None:
    offset = 0
    while offset < len(data):
        written = os.write(descriptor, data[offset:])
        if written <= 0:
            raise OSError("short write while saving refine settings")
        offset += written


RENAME_NOREPLACE = 1
RENAME_EXCHANGE = 2


@dataclass(frozen=True)
class EntrySnapshot:
    identity: tuple[int, int]
    text: str | None


def _rename_noreplace(directory: int, source: str, destination: str) -> None:
    """Linux renameat2(RENAME_NOREPLACE), scoped to one open directory."""
    libc = ctypes.CDLL(None, use_errno=True)
    renameat2 = getattr(libc, "renameat2", None)
    if renameat2 is None:
        raise RuntimeError("renameat2 is required for compare-and-swap settings writes")
    renameat2.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    renameat2.restype = ctypes.c_int
    result = renameat2(
        directory,
        os.fsencode(source),
        directory,
        os.fsencode(destination),
        RENAME_NOREPLACE,
    )
    if result != 0:
        error_number = ctypes.get_errno()
        raise OSError(error_number, os.strerror(error_number), destination)


def _rename_exchange(directory: int, left: str, right: str) -> None:
    """Atomically exchange two existing names inside one open directory."""
    libc = ctypes.CDLL(None, use_errno=True)
    renameat2 = getattr(libc, "renameat2", None)
    if renameat2 is None:
        raise RuntimeError("renameat2 is required for compare-and-swap settings writes")
    renameat2.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    renameat2.restype = ctypes.c_int
    result = renameat2(
        directory,
        os.fsencode(left),
        directory,
        os.fsencode(right),
        RENAME_EXCHANGE,
    )
    if result != 0:
        error_number = ctypes.get_errno()
        raise OSError(error_number, os.strerror(error_number), right)


def _publish_noreplace(directory: int, temporary_name: str, destination_name: str) -> None:
    """Publish a regular temporary inode only while destination is absent."""
    os.link(
        temporary_name,
        destination_name,
        src_dir_fd=directory,
        dst_dir_fd=directory,
        follow_symlinks=False,
    )


def _restore_quarantine(directory: int, quarantine_name: str, destination_name: str) -> bool:
    """Restore a displaced entry without overwriting a concurrent destination."""
    try:
        _rename_noreplace(directory, quarantine_name, destination_name)
        return True
    except FileExistsError:
        return False


def _entry_snapshot_at(directory: int, name: str, limit: int, label: str) -> EntrySnapshot:
    """Capture identity and bounded text from the same opened directory entry."""
    nofollow = getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(
            name,
            os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | nofollow,
            dir_fd=directory,
        )
    except OSError:
        metadata = os.stat(name, dir_fd=directory, follow_symlinks=False)
        return EntrySnapshot((metadata.st_dev, metadata.st_ino), None)
    try:
        metadata = os.fstat(descriptor)
        identity = (metadata.st_dev, metadata.st_ino)
        if not stat.S_ISREG(metadata.st_mode):
            return EntrySnapshot(identity, None)
        return EntrySnapshot(
            identity,
            _read_bounded_descriptor(descriptor, limit, label, name),
        )
    finally:
        os.close(descriptor)


def _preserve_entry(directory: int, source_name: str, destination_name: str) -> str:
    """Move an ambiguous entry aside without overwriting any existing name."""
    for _ in range(16):
        quarantine_name = f".{destination_name}.cas.{secrets.token_hex(8)}"
        try:
            _rename_noreplace(directory, source_name, quarantine_name)
            return quarantine_name
        except FileExistsError:
            continue
        except FileNotFoundError:
            return ""
    # The source remains under its randomized temporary name. The caller must
    # suppress normal temporary cleanup so ambiguous content is never deleted.
    return source_name


def _rollback_exchange_without_overwrite(
    directory: int,
    temporary_name: str,
    destination_name: str,
    candidate: EntrySnapshot,
    limit: int,
    label: str,
) -> None:
    """Remove our exchanged candidate while preserving every concurrent entry."""
    expected_destination = candidate
    try:
        for _ in range(16):
            actual_destination = _entry_snapshot_at(
                directory, destination_name, limit, label
            )
            if actual_destination != expected_destination:
                _preserve_entry(directory, temporary_name, destination_name)
                return

            moving = _entry_snapshot_at(directory, temporary_name, limit, label)
            _rename_exchange(directory, temporary_name, destination_name)
            displaced_after_exchange = _entry_snapshot_at(
                directory, temporary_name, limit, label
            )

            if displaced_after_exchange == expected_destination:
                if displaced_after_exchange == candidate:
                    if (
                        _entry_snapshot_at(directory, temporary_name, limit, label)
                        == candidate
                    ):
                        os.unlink(temporary_name, dir_fd=directory)
                    else:
                        _preserve_entry(directory, temporary_name, destination_name)
                else:
                    _preserve_entry(directory, temporary_name, destination_name)
                return

            # A normal atomic writer replaced the destination between our
            # validation and exchange. It is now safe at the temporary name;
            # install it on the next exchange only while the entry we just
            # installed remains unchanged.
            expected_destination = moving

        _preserve_entry(directory, temporary_name, destination_name)
    except Exception:
        try:
            _preserve_entry(directory, temporary_name, destination_name)
        except Exception:
            pass
        raise


def atomic_write_text(
    path: Path,
    text: str,
    limit: int,
    label: str,
    *,
    expected: str | None | object = ...,
) -> None:
    """Atomically publish *text* through an exclusive private temporary file.

    With existing expected text, the fsynced candidate and destination are
    atomically exchanged, so readers always see a canonical entry. The
    displaced entry is then validated and either committed or safely exchanged
    back. ``None`` requires the destination to remain absent through no-overwrite
    hard-link publication. The omitted sentinel retains legacy unconditional
    replacement behavior.
    """
    data = text.encode("utf-8")
    if len(data) > limit:
        raise RuntimeError(f"{label} is unexpectedly large: {path}")

    directory = _open_parent_directory(path)
    temporary_name = ""
    descriptor = -1
    try:
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW
        for _ in range(16):
            temporary_name = f".{path.name}.tmp.{secrets.token_hex(8)}"
            try:
                descriptor = os.open(temporary_name, flags, 0o600, dir_fd=directory)
                break
            except FileExistsError:
                temporary_name = ""
        if descriptor < 0:
            raise RuntimeError(f"Could not allocate a safe temporary file in {path.parent}")
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise RuntimeError("Temporary refine settings path is not a regular file")

        os.fchmod(descriptor, 0o600)
        _write_all(descriptor, data)
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1

        if expected is ...:
            os.replace(
                temporary_name,
                path.name,
                src_dir_fd=directory,
                dst_dir_fd=directory,
            )
            temporary_name = ""
        elif expected is None:
            try:
                _publish_noreplace(directory, temporary_name, path.name)
            except FileExistsError as error:
                raise RuntimeError(f"{label} changed concurrently: {path}") from error
            os.unlink(temporary_name, dir_fd=directory)
            temporary_name = ""
        else:
            candidate = _entry_snapshot_at(directory, temporary_name, limit, label)
            try:
                _rename_exchange(directory, temporary_name, path.name)
            except FileNotFoundError as error:
                raise RuntimeError(f"{label} changed concurrently: {path}") from error
            except Exception:
                _rollback_exchange_without_overwrite(
                    directory,
                    temporary_name,
                    path.name,
                    candidate,
                    limit,
                    label,
                )
                temporary_name = ""
                os.fsync(directory)
                raise
            try:
                displaced = _entry_snapshot_at(directory, temporary_name, limit, label)
            except Exception:
                _rollback_exchange_without_overwrite(
                    directory,
                    temporary_name,
                    path.name,
                    candidate,
                    limit,
                    label,
                )
                temporary_name = ""
                os.fsync(directory)
                raise
            if displaced.text != expected:
                _rollback_exchange_without_overwrite(
                    directory,
                    temporary_name,
                    path.name,
                    candidate,
                    limit,
                    label,
                )
                temporary_name = ""
                os.fsync(directory)
                raise RuntimeError(f"{label} changed concurrently: {path}")

            # The randomized temporary name should be unreachable to normal
            # writers. Revalidate before unlinking so even an injected swap is
            # treated as an ambiguous conflict rather than deleted.
            if _entry_snapshot_at(directory, temporary_name, limit, label) != displaced:
                _rollback_exchange_without_overwrite(
                    directory,
                    temporary_name,
                    path.name,
                    candidate,
                    limit,
                    label,
                )
                temporary_name = ""
                os.fsync(directory)
                raise RuntimeError(f"{label} changed concurrently: {path}")
            os.unlink(temporary_name, dir_fd=directory)
            temporary_name = ""
        os.fsync(directory)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if temporary_name:
            try:
                os.unlink(temporary_name, dir_fd=directory)
            except FileNotFoundError:
                pass
        os.close(directory)


def atomic_remove_text(path: Path, expected: str, limit: int, label: str) -> None:
    """Remove one exact regular-file value without deleting a concurrent entry."""
    directory = _open_parent_directory(path)
    quarantine_name = ""
    try:
        for _ in range(16):
            quarantine_name = f".{path.name}.cas.{secrets.token_hex(8)}"
            try:
                _rename_noreplace(directory, path.name, quarantine_name)
                break
            except FileExistsError:
                quarantine_name = ""
                continue
            except FileNotFoundError as error:
                quarantine_name = ""
                raise RuntimeError(f"{label} changed concurrently: {path}") from error
        if not quarantine_name:
            raise RuntimeError(f"Could not allocate a safe CAS quarantine in {path.parent}")

        try:
            displaced = _read_bounded_text_at(directory, quarantine_name, limit, label)
        except Exception:
            if _restore_quarantine(directory, quarantine_name, path.name):
                quarantine_name = ""
            os.fsync(directory)
            raise
        if displaced != expected:
            if _restore_quarantine(directory, quarantine_name, path.name):
                quarantine_name = ""
            os.fsync(directory)
            raise RuntimeError(f"{label} changed concurrently: {path}")

        # The moved entry is descriptor-validated as our exact candidate.
        # Deleting it linearizes removal; any concurrent creator at the original
        # destination is a later entry and is never touched.
        os.unlink(quarantine_name, dir_fd=directory)
        quarantine_name = ""
        os.fsync(directory)
    finally:
        # As with write CAS, an un-restored quarantine is deliberately kept.
        os.close(directory)


def refine_config_path() -> Path:
    override = os.environ.get("VOXTYPE_REFINE_CONFIG", "")
    if override:
        return Path(override).expanduser()
    return xdg_path("XDG_CONFIG_HOME", Path.home() / ".config") / "voxtype" / "refine.toml"


def prompt_path() -> Path:
    override = os.environ.get("VOXTYPE_REFINE_PROMPT", "")
    if override:
        return Path(override).expanduser()
    return xdg_path("XDG_CONFIG_HOME", Path.home() / ".config") / "voxtype" / "refine-prompt.md"


def ensure_prompt_file(path: Path) -> Path:
    existing = read_bounded_text(
        path,
        MAX_PROMPT_BYTES,
        "refine prompt",
        missing_ok=True,
    )
    if existing is not None:
        return path
    body = DEFAULT_SYSTEM if DEFAULT_SYSTEM.endswith("\n") else DEFAULT_SYSTEM + "\n"
    atomic_write_text(
        path,
        body,
        MAX_PROMPT_BYTES,
        "refine prompt",
        expected=None,
    )
    return path


def load_system_prompt(path: Path) -> str:
    text = read_bounded_text(
        path,
        MAX_PROMPT_BYTES,
        "refine prompt",
        missing_ok=True,
    )
    if text is None:
        return DEFAULT_SYSTEM
    stripped = text.strip()
    return stripped if stripped else DEFAULT_SYSTEM

def dictionary_path() -> Path:
    override = os.environ.get("VOXTYPE_REFINE_DICTIONARY", "")
    if override:
        return Path(override).expanduser()
    return xdg_path("XDG_CONFIG_HOME", Path.home() / ".config") / "voxtype" / "refine-dictionary.md"


def ensure_dictionary_file(path: Path) -> Path:
    existing = read_bounded_text(
        path,
        MAX_DICTIONARY_BYTES,
        "refine dictionary",
        missing_ok=True,
    )
    if existing is not None:
        return path
    body = DEFAULT_DICTIONARY if DEFAULT_DICTIONARY.endswith("\n") else DEFAULT_DICTIONARY + "\n"
    atomic_write_text(
        path,
        body,
        MAX_DICTIONARY_BYTES,
        "refine dictionary",
        expected=None,
    )
    return path


def load_dictionary(path: Path) -> str:
    text = read_bounded_text(
        path,
        MAX_DICTIONARY_BYTES,
        "refine dictionary",
        missing_ok=True,
    )
    if text is None:
        return ""
    return dictionary_terms(text)


def dictionary_terms(text: str) -> str:
    terms: list[str] = []
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        terms.append(stripped)
    return "\n".join(terms)

SECRET_ASSIGNMENT_RE = re.compile(
    r"(?i)(?:password|passwd|passcode|secret|token|api[ _-]key|authorization)\s*[:=]"
)
MASK_RUN_RE = re.compile(r"[*•●]{4,}")
EMAIL_RE = re.compile(r"\b[A-Z0-9._%+\-]+@[A-Z0-9.\-]+\.[A-Z]{2,}\b", re.I)
URL_RE = re.compile(r"https?://[^\s]+", re.I)
JWT_RE = re.compile(r"\b[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\b")
HEX_RE = re.compile(r"\b[0-9A-Fa-f]{16,}\b")
TOKEN_RE = re.compile(r"[^\W_]+(?:[._\-'’][^\W_]+)*")
BACKTICK_IDENT_RE = re.compile(r"`([A-Za-z][A-Za-z0-9._\-]*)`")
TIMES_TOKEN_RE = re.compile(r"×\d+")
_DIGIT_WORDS = {
    "zero": "0",
    "oh": "0",
    "one": "1",
    "two": "2",
    "three": "3",
    "four": "4",
    "five": "5",
