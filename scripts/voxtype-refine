def xdg_path(env_name: str, fallback: Path) -> Path:
    value = os.environ.get(env_name, "")
    return Path(value).expanduser() if value else fallback


def path_entry_exists(path: Path) -> bool:
    """Return whether a directory entry exists without following its target."""
    try:
        os.lstat(path)
        return True
    except FileNotFoundError:
        return False


def read_bounded_text(
    path: Path,
    limit: int,
    label: str,
    *,
    missing_ok: bool = False,
) -> str | None:
    """Read one UTF-8 regular file without following the final path component."""
    nofollow = getattr(os, "O_NOFOLLOW", 0)
    if nofollow == 0:
        raise RuntimeError(f"O_NOFOLLOW is required for {label} access")
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | nofollow)
    except FileNotFoundError:
        if missing_ok:
            return None
        raise RuntimeError(f"{label} not found: {path}") from None
    except OSError as error:
        raise RuntimeError(f"Refusing unsafe {label} path: {path}") from error

    try:
        return _read_bounded_descriptor(descriptor, limit, label, str(path))
    finally:
        os.close(descriptor)


def _read_bounded_descriptor(descriptor: int, limit: int, label: str, display_path: str) -> str:
    metadata = os.fstat(descriptor)
    if not stat.S_ISREG(metadata.st_mode):
        raise RuntimeError(f"{label} is not a regular file: {display_path}")
    if metadata.st_size > limit:
        raise RuntimeError(f"{label} is unexpectedly large: {display_path}")

    chunks: list[bytes] = []
    collected = 0
    while collected <= limit:
        chunk = os.read(descriptor, min(64 * 1024, limit + 1 - collected))
        if not chunk:
            break
        chunks.append(chunk)
        collected += len(chunk)
    if collected > limit:
        raise RuntimeError(f"{label} grew beyond the byte limit: {display_path}")
    try:
        return b"".join(chunks).decode("utf-8")
    except UnicodeDecodeError as error:
        raise RuntimeError(f"{label} is not valid UTF-8: {display_path}") from error


def _read_bounded_text_at(directory: int, name: str, limit: int, label: str) -> str:
    nofollow = getattr(os, "O_NOFOLLOW", 0)
    if nofollow == 0:
        raise RuntimeError(f"O_NOFOLLOW is required for {label} access")
    try:
        descriptor = os.open(
            name,
            os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | nofollow,
            dir_fd=directory,
        )
    except OSError as error:
        raise RuntimeError(f"Refusing unsafe {label} quarantine") from error
    try:
        return _read_bounded_descriptor(descriptor, limit, label, name)
    finally:
        os.close(descriptor)


def _open_parent_directory(path: Path) -> int:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    nofollow = getattr(os, "O_NOFOLLOW", 0)
    if nofollow == 0:
        raise RuntimeError("O_NOFOLLOW is required for settings writes")
    try:
        descriptor = os.open(
            path.parent,
            os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | nofollow,
        )
    except OSError as error:
        raise RuntimeError(f"Refusing unsafe settings directory: {path.parent}") from error
    if not stat.S_ISDIR(os.fstat(descriptor).st_mode):
        os.close(descriptor)
        raise RuntimeError(f"Settings parent is not a directory: {path.parent}")
    return descriptor


def _write_all(descriptor: int, data: bytes) -> None:
    offset = 0
    while offset < len(data):
        written = os.write(descriptor, data[offset:])
        if written <= 0:
            raise OSError("short write while saving refine settings")
        offset += written


RENAME_NOREPLACE = 1
RENAME_EXCHANGE = 2


@dataclass(frozen=True)
class EntrySnapshot:
    identity: tuple[int, int]
    text: str | None


def _rename_noreplace(directory: int, source: str, destination: str) -> None:
    """Linux renameat2(RENAME_NOREPLACE), scoped to one open directory."""
    libc = ctypes.CDLL(None, use_errno=True)
    renameat2 = getattr(libc, "renameat2", None)
    if renameat2 is None:
        raise RuntimeError("renameat2 is required for compare-and-swap settings writes")
    renameat2.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    renameat2.restype = ctypes.c_int
    result = renameat2(
        directory,
        os.fsencode(source),
        directory,
        os.fsencode(destination),
        RENAME_NOREPLACE,
    )
    if result != 0:
        error_number = ctypes.get_errno()
        raise OSError(error_number, os.strerror(error_number), destination)


def _rename_exchange(directory: int, left: str, right: str) -> None:
    """Atomically exchange two existing names inside one open directory."""
    libc = ctypes.CDLL(None, use_errno=True)
    renameat2 = getattr(libc, "renameat2", None)
    if renameat2 is None:
        raise RuntimeError("renameat2 is required for compare-and-swap settings writes")
    renameat2.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    renameat2.restype = ctypes.c_int
    result = renameat2(
        directory,
        os.fsencode(left),
        directory,
        os.fsencode(right),
        RENAME_EXCHANGE,
    )
    if result != 0:
        error_number = ctypes.get_errno()
        raise OSError(error_number, os.strerror(error_number), right)


def _publish_noreplace(directory: int, temporary_name: str, destination_name: str) -> None:
    """Publish a regular temporary inode only while destination is absent."""
    os.link(
        temporary_name,
        destination_name,
        src_dir_fd=directory,
        dst_dir_fd=directory,
        follow_symlinks=False,
    )


def _restore_quarantine(directory: int, quarantine_name: str, destination_name: str) -> bool:
    """Restore a displaced entry without overwriting a concurrent destination."""
    try:
        _rename_noreplace(directory, quarantine_name, destination_name)
        return True
    except FileExistsError:
        return False


def _entry_snapshot_at(directory: int, name: str, limit: int, label: str) -> EntrySnapshot:
    """Capture identity and bounded text from the same opened directory entry."""
    nofollow = getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(
            name,
            os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | nofollow,
            dir_fd=directory,
        )
    except OSError:
        metadata = os.stat(name, dir_fd=directory, follow_symlinks=False)
        return EntrySnapshot((metadata.st_dev, metadata.st_ino), None)
    try:
        metadata = os.fstat(descriptor)
        identity = (metadata.st_dev, metadata.st_ino)
        if not stat.S_ISREG(metadata.st_mode):
            return EntrySnapshot(identity, None)
        return EntrySnapshot(
            identity,
            _read_bounded_descriptor(descriptor, limit, label, name),
        )
    finally:
        os.close(descriptor)


def _preserve_entry(directory: int, source_name: str, destination_name: str) -> str:
    """Move an ambiguous entry aside without overwriting any existing name."""
    for _ in range(16):
        quarantine_name = f".{destination_name}.cas.{secrets.token_hex(8)}"
        try:
            _rename_noreplace(directory, source_name, quarantine_name)
            return quarantine_name
        except FileExistsError:
            continue
        except FileNotFoundError:
            return ""
    # The source remains under its randomized temporary name. The caller must
    # suppress normal temporary cleanup so ambiguous content is never deleted.
    return source_name


def _rollback_exchange_without_overwrite(
    directory: int,
    temporary_name: str,
    destination_name: str,
    candidate: EntrySnapshot,
    limit: int,
    label: str,
) -> None:
    """Remove our exchanged candidate while preserving every concurrent entry."""
    expected_destination = candidate
    try:
        for _ in range(16):
            actual_destination = _entry_snapshot_at(
                directory, destination_name, limit, label
            )
            if actual_destination != expected_destination:
                _preserve_entry(directory, temporary_name, destination_name)
                return

            moving = _entry_snapshot_at(directory, temporary_name, limit, label)
            _rename_exchange(directory, temporary_name, destination_name)
            displaced_after_exchange = _entry_snapshot_at(
                directory, temporary_name, limit, label
            )

            if displaced_after_exchange == expected_destination:
                if displaced_after_exchange == candidate:
                    if (
                        _entry_snapshot_at(directory, temporary_name, limit, label)
                        == candidate
                    ):
                        os.unlink(temporary_name, dir_fd=directory)
                    else:
                        _preserve_entry(directory, temporary_name, destination_name)
                else:
                    _preserve_entry(directory, temporary_name, destination_name)
                return

            # A normal atomic writer replaced the destination between our
            # validation and exchange. It is now safe at the temporary name;
            # install it on the next exchange only while the entry we just
            # installed remains unchanged.
            expected_destination = moving

        _preserve_entry(directory, temporary_name, destination_name)
    except Exception:
        try:
            _preserve_entry(directory, temporary_name, destination_name)
        except Exception:
            pass
        raise


def atomic_write_text(
    path: Path,
    text: str,
    limit: int,
    label: str,
    *,
    expected: str | None | object = ...,
) -> None:
    """Atomically publish *text* through an exclusive private temporary file.

    With existing expected text, the fsynced candidate and destination are
    atomically exchanged, so readers always see a canonical entry. The
    displaced entry is then validated and either committed or safely exchanged
    back. ``None`` requires the destination to remain absent through no-overwrite
    hard-link publication. The omitted sentinel retains legacy unconditional
    replacement behavior.
    """
    data = text.encode("utf-8")
    if len(data) > limit:
        raise RuntimeError(f"{label} is unexpectedly large: {path}")

    directory = _open_parent_directory(path)
    temporary_name = ""
    descriptor = -1
    try:
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW
        for _ in range(16):
            temporary_name = f".{path.name}.tmp.{secrets.token_hex(8)}"
            try:
                descriptor = os.open(temporary_name, flags, 0o600, dir_fd=directory)
                break
            except FileExistsError:
                temporary_name = ""
        if descriptor < 0:
            raise RuntimeError(f"Could not allocate a safe temporary file in {path.parent}")
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise RuntimeError("Temporary refine settings path is not a regular file")

        os.fchmod(descriptor, 0o600)
        _write_all(descriptor, data)
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1

        if expected is ...:
            os.replace(
                temporary_name,
                path.name,
                src_dir_fd=directory,
                dst_dir_fd=directory,
            )
            temporary_name = ""
        elif expected is None:
            try:
                _publish_noreplace(directory, temporary_name, path.name)
            except FileExistsError as error:
                raise RuntimeError(f"{label} changed concurrently: {path}") from error
            os.unlink(temporary_name, dir_fd=directory)
            temporary_name = ""
        else:
            candidate = _entry_snapshot_at(directory, temporary_name, limit, label)
            try:
                _rename_exchange(directory, temporary_name, path.name)
            except FileNotFoundError as error:
                raise RuntimeError(f"{label} changed concurrently: {path}") from error
            except Exception:
                _rollback_exchange_without_overwrite(
                    directory,
                    temporary_name,
                    path.name,
                    candidate,
                    limit,
                    label,
                )
                temporary_name = ""
                os.fsync(directory)
                raise
            try:
                displaced = _entry_snapshot_at(directory, temporary_name, limit, label)
            except Exception:
                _rollback_exchange_without_overwrite(
                    directory,
                    temporary_name,
                    path.name,
                    candidate,
                    limit,
                    label,
                )
                temporary_name = ""
                os.fsync(directory)
                raise
            if displaced.text != expected:
                _rollback_exchange_without_overwrite(
                    directory,
                    temporary_name,
                    path.name,
                    candidate,
                    limit,
                    label,
                )
                temporary_name = ""
                os.fsync(directory)
                raise RuntimeError(f"{label} changed concurrently: {path}")

            # The randomized temporary name should be unreachable to normal
            # writers. Revalidate before unlinking so even an injected swap is
            # treated as an ambiguous conflict rather than deleted.
            if _entry_snapshot_at(directory, temporary_name, limit, label) != displaced:
                _rollback_exchange_without_overwrite(
                    directory,
                    temporary_name,
                    path.name,
                    candidate,
                    limit,
                    label,
                )
                temporary_name = ""
                os.fsync(directory)
                raise RuntimeError(f"{label} changed concurrently: {path}")
            os.unlink(temporary_name, dir_fd=directory)
            temporary_name = ""
        os.fsync(directory)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if temporary_name:
            try:
                os.unlink(temporary_name, dir_fd=directory)
            except FileNotFoundError:
                pass
        os.close(directory)


def atomic_remove_text(path: Path, expected: str, limit: int, label: str) -> None:
    """Remove one exact regular-file value without deleting a concurrent entry."""
    directory = _open_parent_directory(path)
    quarantine_name = ""
    try:
        for _ in range(16):
            quarantine_name = f".{path.name}.cas.{secrets.token_hex(8)}"
            try:
                _rename_noreplace(directory, path.name, quarantine_name)
                break
            except FileExistsError:
                quarantine_name = ""
                continue
            except FileNotFoundError as error:
                quarantine_name = ""
                raise RuntimeError(f"{label} changed concurrently: {path}") from error
        if not quarantine_name:
            raise RuntimeError(f"Could not allocate a safe CAS quarantine in {path.parent}")

        try:
            displaced = _read_bounded_text_at(directory, quarantine_name, limit, label)
        except Exception:
            if _restore_quarantine(directory, quarantine_name, path.name):
                quarantine_name = ""
            os.fsync(directory)
            raise
        if displaced != expected:
            if _restore_quarantine(directory, quarantine_name, path.name):
                quarantine_name = ""
            os.fsync(directory)
            raise RuntimeError(f"{label} changed concurrently: {path}")

        # The moved entry is descriptor-validated as our exact candidate.
        # Deleting it linearizes removal; any concurrent creator at the original
        # destination is a later entry and is never touched.
        os.unlink(quarantine_name, dir_fd=directory)
        quarantine_name = ""
        os.fsync(directory)
    finally:
        # As with write CAS, an un-restored quarantine is deliberately kept.
        os.close(directory)


def refine_config_path() -> Path:
    override = os.environ.get("VOXTYPE_REFINE_CONFIG", "")
    if override:
        return Path(override).expanduser()
    return xdg_path("XDG_CONFIG_HOME", Path.home() / ".config") / "voxtype" / "refine.toml"


def prompt_path() -> Path:
    override = os.environ.get("VOXTYPE_REFINE_PROMPT", "")
    if override:
        return Path(override).expanduser()
    return xdg_path("XDG_CONFIG_HOME", Path.home() / ".config") / "voxtype" / "refine-prompt.md"


def ensure_prompt_file(path: Path) -> Path:
    existing = read_bounded_text(
        path,
        MAX_PROMPT_BYTES,
        "refine prompt",
        missing_ok=True,
    )
    if existing is not None:
        return path
    body = DEFAULT_SYSTEM if DEFAULT_SYSTEM.endswith("\n") else DEFAULT_SYSTEM + "\n"
    atomic_write_text(
        path,
        body,
        MAX_PROMPT_BYTES,
        "refine prompt",
        expected=None,
    )
    return path


def load_system_prompt(path: Path) -> str:
    text = read_bounded_text(
        path,
        MAX_PROMPT_BYTES,
        "refine prompt",
        missing_ok=True,
    )
    if text is None:
        return DEFAULT_SYSTEM
    stripped = text.strip()
    return stripped if stripped else DEFAULT_SYSTEM

def dictionary_path() -> Path:
    override = os.environ.get("VOXTYPE_REFINE_DICTIONARY", "")
    if override:
        return Path(override).expanduser()
    return xdg_path("XDG_CONFIG_HOME", Path.home() / ".config") / "voxtype" / "refine-dictionary.md"


def ensure_dictionary_file(path: Path) -> Path:
    existing = read_bounded_text(
        path,
        MAX_DICTIONARY_BYTES,
        "refine dictionary",
        missing_ok=True,
    )
    if existing is not None:
        return path
    body = DEFAULT_DICTIONARY if DEFAULT_DICTIONARY.endswith("\n") else DEFAULT_DICTIONARY + "\n"
    atomic_write_text(
        path,
        body,
        MAX_DICTIONARY_BYTES,
        "refine dictionary",
        expected=None,
    )
    return path


def load_dictionary(path: Path) -> str:
    text = read_bounded_text(
        path,
        MAX_DICTIONARY_BYTES,
        "refine dictionary",
        missing_ok=True,
    )
    if text is None:
        return ""
    return dictionary_terms(text)


def dictionary_terms(text: str) -> str:
    terms: list[str] = []
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        terms.append(stripped)
    return "\n".join(terms)


def compose_system_prompt(prompt: str) -> str:
    return prompt.strip()


def build_refinement_input(raw: str, context: str = "", dictionary: str = "") -> str:
    payload = {}
    if context:
        payload["context_for_disambiguation_only"] = context
    spellings = [line.strip() for line in dictionary.splitlines() if line.strip()]
    if spellings:
        payload["preferred_spellings"] = spellings
    payload["transcript"] = raw
    return json.dumps(payload, ensure_ascii=False, separators=(",", ":"))



def parse_refine_toml(text: str) -> dict[str, str]:
    values: dict[str, str] = {}
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or stripped.startswith("["):
            continue
        key, separator, raw = stripped.partition("=")
        if not separator:
            continue
        value = raw.split("#", 1)[0].strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        values[key.strip()] = value
    return values


def load_selection(path: Path) -> tuple[Provider, str]:
    provider_id = DEFAULT_PROVIDER
    model_override: str | None = None
    text = read_bounded_text(
        path,
        MAX_REFINE_CONFIG_BYTES,
        "refine config",
        missing_ok=True,
    )
    if text is not None:
        parsed = parse_refine_toml(text)
        if parsed.get("provider"):
            provider_id = parsed["provider"].strip().lower()
        if parsed.get("model"):
            model_override = parsed["model"].strip()
    env_provider = os.environ.get("VOXTYPE_REFINE_PROVIDER", "").strip().lower()
    if env_provider:
        provider_id = env_provider
    if provider_id not in PROVIDERS:
        raise RuntimeError(f"unknown refine provider {provider_id!r}")
    provider = PROVIDERS[provider_id]
    if provider.id == "local":
        override = os.environ.get("VOXTYPE_LOCAL_BASE_URL", "").strip()
        if override:
            provider = replace(provider, base_url=override)
    model = os.environ.get("VOXTYPE_REFINE_MODEL", "").strip() or model_override or provider.model
    return provider, model


def write_refine_config(path: Path, provider_id: str) -> None:
    if provider_id not in PROVIDERS:
        raise RuntimeError(f"unknown refine provider {provider_id!r}")
    for _ in range(8):
        current = read_bounded_text(
            path,
            MAX_REFINE_CONFIG_BYTES,
            "refine config",
            missing_ok=True,
        )
        if current is None:
            updated = (
                "# Voxtype LLM refine provider. Switched by: voxtype-refine set <id>\n"
                f"provider = {json.dumps(provider_id)}\n"
            )
        else:
            updated = set_top_level_string(current, "provider", provider_id)
        if updated == current:
            return
        try:
            atomic_write_text(
                path,
                updated,
                MAX_REFINE_CONFIG_BYTES,
                "refine config",
                expected=current,
            )
            return
        except RuntimeError as error:
            if "changed concurrently" not in str(error):
                raise
    raise RuntimeError(f"refine config kept changing during update: {path}")


def set_top_level_string(text: str, key: str, value: str | None) -> str:
    """Losslessly set/remove one top-level TOML string assignment."""
    lines = text.splitlines(keepends=True)
    in_top_level = True
    for index, line in enumerate(lines):
        if re.match(r"^\s*\[[^]]+\]", line):
            in_top_level = False
        if not in_top_level or line.lstrip().startswith("#"):
            continue
        match = re.match(rf"^(\s*){re.escape(key)}\s*=.*?(\r?\n)?$", line)
        if not match:
            continue
        if value is None:
            del lines[index]
        else:
            newline = "\r\n" if line.endswith("\r\n") else "\n" if line.endswith("\n") else ""
            lines[index] = f"{match.group(1)}{key} = {json.dumps(value)}{newline}"
        return "".join(lines)

    if value is None:
        return text
    insert_at = next(
        (index for index, line in enumerate(lines) if re.match(r"^\s*\[[^]]+\]", line)),
        len(lines),
    )
    prefix = "" if insert_at == 0 or lines[insert_at - 1].endswith(("\n", "\r\n")) else "\n"
    lines.insert(insert_at, f"{prefix}{key} = {json.dumps(value)}\n")
    return "".join(lines)


def strip_output(text: str) -> str:
    text = THINK_RE.sub("", text).strip()
    if len(text) >= 2 and text[0] == text[-1] and text[0] in "\"'":
        text = text[1:-1].strip()
    return text


def openai_message_text(payload: dict[str, Any]) -> str:
    choices = payload.get("choices") or []
    if not choices:
        return ""
    message = choices[0].get("message") or {}
    return strip_output(str(message.get("content") or ""))


def anthropic_message_text(payload: dict[str, Any]) -> str:
    chunks: list[str] = []
    for block in payload.get("content") or []:
        if isinstance(block, dict) and block.get("type") == "text":
            chunks.append(str(block.get("text") or ""))
    return strip_output("".join(chunks))


def collect_codex_sse(raw: bytes) -> str:
    texts: list[str] = []
    for event in raw.replace(b"\r\n", b"\n").split(b"\n\n"):
        for line in event.split(b"\n"):
            if not line.startswith(b"data:"):
                continue
            data = line[5:].strip()
            if data in (b"", b"[DONE]"):
                continue
            try:
                payload = json.loads(data)
            except json.JSONDecodeError:
                continue
            if payload.get("type") == "response.output_text.delta":
                texts.append(str(payload.get("delta") or ""))
    return strip_output("".join(texts))


def expiry_seconds(expires: Any) -> float | None:
    if not isinstance(expires, (int, float)):
        return None
    value = float(expires)
    if value > 10_000_000_000:
        value /= 1000.0
    return value


def credential_database_path() -> Path:
    override = os.environ.get("VOXTYPE_OMP_AGENT_DB", "")
    return Path(override).expanduser() if override else Path.home() / ".omp" / "agent" / "agent.db"


def _credential_database_identity(path: Path) -> tuple[int, int, int] | None:
    """Return a bounded regular-file identity without following the path."""
    try:
        metadata = os.lstat(path)
    except FileNotFoundError:
        return None
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
        raise RuntimeError("unsafe credential database")
    if metadata.st_size > MAX_CREDENTIAL_DB_BYTES:
        raise RuntimeError("credential database is unexpectedly large")
    return metadata.st_dev, metadata.st_ino, metadata.st_size


def _assert_credential_database_unchanged(
    path: Path,
    expected: tuple[int, int, int],
) -> None:
    if _credential_database_identity(path) != expected:
        raise RuntimeError("credential database changed while reading")


def _credential_missing(missing_ok: bool) -> None:
    if missing_ok:
        return None
    raise RuntimeError("no OhMyPi login for the selected provider; run omp /login")


def _load_credential_payload(
    provider_id: str,
    *,
    missing_ok: bool,
) -> dict[str, Any] | None:
    """Read one bounded credential object from a stable read-only database."""
    path = credential_database_path()
    identity = _credential_database_identity(path)
    if identity is None:
        return _credential_missing(missing_ok)

    absolute_path = os.path.abspath(os.fspath(path))
    uri = f"file:{urllib.parse.quote(absolute_path, safe='/')}?mode=ro"
    try:
        connection = sqlite3.connect(uri, uri=True)
    except sqlite3.Error as error:
        _assert_credential_database_unchanged(path, identity)
        raise RuntimeError("could not read the OhMyPi credential database") from error

    try:
        _assert_credential_database_unchanged(path, identity)
        try:
            row = connection.execute(
                "select substr(cast(data as blob), 1, ?) "
                "from auth_credentials where provider = ? limit 1",
                (MAX_CREDENTIAL_JSON_BYTES + 1, provider_id),
            ).fetchone()
        except sqlite3.Error as error:
            _assert_credential_database_unchanged(path, identity)
            raise RuntimeError("could not read the OhMyPi credential database") from error
        _assert_credential_database_unchanged(path, identity)
    finally:
        connection.close()

    if row is None or row[0] is None:
        return _credential_missing(missing_ok)
    raw = row[0]
    if isinstance(raw, memoryview):
        encoded = raw.tobytes()
    elif isinstance(raw, bytes):
        encoded = raw
    elif isinstance(raw, str):
        encoded = raw.encode("utf-8")
    else:
        raise RuntimeError("OhMyPi credential data has an invalid shape")
    if len(encoded) > MAX_CREDENTIAL_JSON_BYTES:
        raise RuntimeError("OhMyPi credential data is too large")
    try:
        data = json.loads(encoded.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise RuntimeError("OhMyPi credential data is invalid") from error
    if not isinstance(data, dict):
        raise RuntimeError("OhMyPi credential data has an invalid shape")
    return data


def load_oauth(provider_id: str, *, missing_ok: bool = False) -> dict[str, Any] | None:
    data = _load_credential_payload(provider_id, missing_ok=missing_ok)
    if data is None:
        return None
    access = data.get("access")
    if access is None or (isinstance(access, str) and not access.strip()):
        if missing_ok:
            return None
        raise RuntimeError("OhMyPi credential is missing an access token")
    if not isinstance(access, str):
        raise RuntimeError("OhMyPi credential data has an invalid shape")
    return data


def oauth_available(provider_id: str) -> bool:
    """Return readiness without exposing a credential object to the caller."""
    return load_oauth(provider_id, missing_ok=True) is not None


def refresh_oauth(omp_provider: str, cred: dict[str, Any]) -> str:
    access = str(cred.get("access") or "")
    refresh = str(cred.get("refresh") or "")
    expires = expiry_seconds(cred.get("expires"))
    if expires is not None and expires - time.time() > 90:
        return access
    if not refresh:
        return access

    if omp_provider == "xai-oauth":
        url = "https://auth.x.ai/oauth2/token"
        body = urllib.parse.urlencode(
            {
                "grant_type": "refresh_token",
                "refresh_token": refresh,
                "client_id": "b1a00492-073a-47ea-816f-4c329264a828",
            }
        ).encode()
        headers = {"Content-Type": "application/x-www-form-urlencoded"}
    elif omp_provider == "anthropic":
        url = "https://api.anthropic.com/v1/oauth/token"
        body = json.dumps(
            {
                "grant_type": "refresh_token",
                "refresh_token": refresh,
                "client_id": "9d1c250a-e61b-44d9-88ed-5944d1962f5e",
            }
        ).encode()
        headers = {"Content-Type": "application/json"}
    elif omp_provider == "openai-codex":
        url = "https://auth.openai.com/oauth/token"
        body = urllib.parse.urlencode(
            {
                "grant_type": "refresh_token",
                "refresh_token": refresh,
                "client_id": "app_EMoamEEZ73f0CkXaXp7hrann",
            }
        ).encode()
        headers = {"Content-Type": "application/x-www-form-urlencoded"}
    else:
        return access

    req = urllib.request.Request(url, data=body, headers=headers, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            payload = json.loads(read_bounded_response(resp).decode("utf-8"))
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, UnicodeDecodeError, OSError, RuntimeError):
        return access
    token = payload.get("access_token")
    return str(token) if token else access


def read_bounded_response(response: Any, limit: int = MAX_NETWORK_RESPONSE_BYTES) -> bytes:
    """Read a provider response with a hard ceiling, regardless of headers."""
    content_length = None
    headers = getattr(response, "headers", None)
    if headers is not None:
        try:
            raw_length = headers.get("Content-Length")
            content_length = int(raw_length) if raw_length is not None else None
        except (TypeError, ValueError):
            content_length = None
    if content_length is not None and content_length > limit:
        raise RuntimeError("refine provider response exceeded the byte limit")

    chunks: list[bytes] = []
    collected = 0
    while collected <= limit:
        chunk = response.read(min(NETWORK_READ_CHUNK_BYTES, limit + 1 - collected))
        if not chunk:
            break
        chunks.append(chunk)
        collected += len(chunk)
    if collected > limit:
        raise RuntimeError("refine provider response exceeded the byte limit")
    return b"".join(chunks)


def http_json(url: str, headers: dict[str, str], payload: dict[str, Any], timeout: float) -> dict[str, Any]:
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers=headers,
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        decoded = json.loads(read_bounded_response(resp).decode("utf-8"))
    if not isinstance(decoded, dict):
        raise RuntimeError("refine provider returned an invalid JSON response")
    return decoded


def http_bytes(url: str, headers: dict[str, str], payload: dict[str, Any], timeout: float) -> bytes:
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers=headers,
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return read_bounded_response(resp)


def complete(provider: Provider, model: str, user: str, system: str) -> str:
    timeout = float(os.environ.get("VOXTYPE_LLM_TIMEOUT", "25"))
    if provider.api == "openai-completions":
        headers = {"Content-Type": "application/json"}
        if provider.omp_provider:
            token = refresh_oauth(provider.omp_provider, load_oauth(provider.omp_provider))
            headers["Authorization"] = f"Bearer {token}"
        payload: dict[str, Any] = {
            "model": model,
            "temperature": 0.1,
            "max_tokens": 2048,
            "messages": [
                {"role": "system", "content": system},
                {"role": "user", "content": user},
            ],
        }
        if provider.id == "local":
            payload["chat_template_kwargs"] = {"enable_thinking": False}
        data = http_json(f"{provider.base_url.rstrip('/')}/chat/completions", headers, payload, timeout)
        return openai_message_text(data)

    if provider.api == "anthropic-messages":
        token = refresh_oauth("anthropic", load_oauth("anthropic"))
        data = http_json(
            f"{provider.base_url.rstrip('/')}/v1/messages",
            {
                "Authorization": f"Bearer {token}",
                "Content-Type": "application/json",
                "anthropic-version": "2023-06-01",
            },
            {
                "model": model,
                "max_tokens": 2048,
                "system": system,
                "messages": [{"role": "user", "content": user}],
            },
            timeout,
        )
        return anthropic_message_text(data)

    if provider.api == "openai-codex-responses":
        cred = load_oauth("openai-codex")
        token = refresh_oauth("openai-codex", cred)
        headers = {
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
            "Accept": "text/event-stream",
        }
        account = cred.get("accountId")
        if account:
            headers["ChatGPT-Account-Id"] = str(account)
        raw = http_bytes(
            provider.base_url,
            headers,
            {
                "model": model,
                "instructions": system,
                "input": [{"role": "user", "content": [{"type": "input_text", "text": user}]}],
                "store": False,
                "stream": True,
            },
            timeout,
        )
        return collect_codex_sse(raw)

    raise RuntimeError(f"unsupported refine api {provider.api}")



def refine_text(raw: str) -> str:
    if not raw.strip():
        return raw
    context = os.environ.get("VOXTYPE_CONTEXT", "").strip()
    dictionary = load_dictionary(dictionary_path())
    provider, model = load_selection(refine_config_path())
    cleaned = complete(
        provider,
        model,
        build_refinement_input(raw, context, dictionary),
        compose_system_prompt(load_system_prompt(prompt_path())),
    )

    if not cleaned:
        raise RuntimeError("refine provider returned empty text")
    if raw.endswith("\n") and not cleaned.endswith("\n"):
        cleaned += "\n"
    return cleaned



def cmd_list() -> int:
    selected, _ = load_selection(refine_config_path())
    for provider in PROVIDERS.values():
        mark = "*" if provider.id == selected.id else " "
        print(f"{mark} {provider.id:<10} {provider.label}  [{provider.model}]")
    return 0


def cmd_status() -> int:
    provider, model = load_selection(refine_config_path())
    print(f"provider={provider.id}")
    print(f"model={model}")
    print(f"label={provider.label}")
    print(f"config={refine_config_path()}")
    print(f"prompt={prompt_path()}")
    print(f"dictionary={dictionary_path()}")

    return 0


def cmd_set(provider_id: str) -> int:
    write_refine_config(refine_config_path(), provider_id)
    provider, model = load_selection(refine_config_path())
    print(f"refine provider set to {provider.id} ({model})")
    return 0


def cmd_prompt() -> int:
    path = ensure_prompt_file(prompt_path())
    system = compose_system_prompt(load_system_prompt(path))
    print(f"prompt={path}")
    print(f"dictionary={dictionary_path()}")
    print("---")
    print(system, end="" if system.endswith("\n") else "\n")
    return 0


def cmd_edit_prompt() -> int:
    path = ensure_prompt_file(prompt_path())
    editor = os.environ.get("EDITOR") or os.environ.get("VISUAL") or "nvim"
    return subprocess.call([editor, str(path)])


def cmd_dictionary() -> int:
    path = dictionary_path()
    text = load_dictionary(path)
    print(f"dictionary={path}")
    print("---")
    if not text:
        print("(empty)")
        return 0
    print(text, end="" if text.endswith("\n") else "\n")
    return 0


def cmd_edit_dictionary() -> int:
    path = ensure_dictionary_file(dictionary_path())
    editor = os.environ.get("EDITOR") or os.environ.get("VISUAL") or "nvim"
    return subprocess.call([editor, str(path)])



def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    sub = result.add_subparsers(dest="action")
    sub.add_parser("list", help="list refine providers")
    sub.add_parser("status", help="show the active refine provider")
    set_cmd = sub.add_parser("set", help="switch the refine provider")
    set_cmd.add_argument("provider", choices=sorted(PROVIDERS))
    sub.add_parser("prompt", help="print the assembled system prompt")
    sub.add_parser("edit-prompt", help="open the system prompt in $EDITOR")
    sub.add_parser("dictionary", help="print the dictionary path and terms")
    sub.add_parser("edit-dictionary", help="open the dictionary in $EDITOR")

    return result


def read_bounded_stdin(limit: int = MAX_TRANSCRIPT_BYTES) -> str:
    raw = sys.stdin.buffer.read(limit + 1)
    if len(raw) > limit:
        raise RuntimeError("transcript exceeded the byte limit")
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError as error:
        raise RuntimeError("transcript is not valid UTF-8") from error



def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if argv:
        args = parser().parse_args(argv)
        if args.action == "list":
            return cmd_list()
        if args.action == "status":
            return cmd_status()
        if args.action == "set":
            return cmd_set(args.provider)
        if args.action == "prompt":
            return cmd_prompt()
        if args.action == "edit-prompt":
            return cmd_edit_prompt()
        if args.action == "dictionary":
            return cmd_dictionary()
        if args.action == "edit-dictionary":
            return cmd_edit_dictionary()

        return 2
    try:
        sys.stdout.write(refine_text(read_bounded_stdin()))
        return 0
    except (OSError, RuntimeError, urllib.error.URLError, TimeoutError, json.JSONDecodeError, sqlite3.Error):
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
