class ScreenTextSource(Protocol):
    def read_text(self) -> str:
        """Return focused-window text, or empty when capture is skipped."""


@dataclass(frozen=True)
class FixtureSource:
    text: str

    def read_text(self) -> str:
        return self.text


def _bound_on_screen_spellings(values: object) -> list[str]:
    if not isinstance(values, list):
        return []
    terms: list[str] = []
    seen: set[str] = set()
    for item in values:
        if not isinstance(item, str):
            continue
        term = item.strip()
        if not term or len(term) > MAX_ON_SCREEN_SPELLING_CHARS or term in seen:
            continue
        candidate = terms + [term]
        encoded = json.dumps(candidate, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
        if len(candidate) > MAX_ON_SCREEN_SPELLINGS or len(encoded) > MAX_ON_SCREEN_SPELLINGS_JSON_BYTES:
            break
        seen.add(term)
        terms.append(term)
    return terms


@dataclass(frozen=True)
class OnScreenCapture:
    live: list[str]
    cached: list[str] = field(default_factory=list)
    window: str = ""

    @property
    def joiner(self) -> list[str]:
        return _bound_on_screen_spellings([*self.live, *self.cached])


def _keep_spelling_token(token: str) -> bool:
    if token.casefold() in _SCREEN_STOPWORDS:
        return False
    letters = [character for character in token if character.isalpha()]
    if len(token) < 3:
        if any(character.isdigit() for character in token) and (
            letters or "×" in token or token[:1] in "xX"
        ):
            return True
        return bool(letters) and len(letters) >= 2 and all(character.isupper() for character in letters)
    if letters and any(character.isdigit() for character in token):
        return True
    if "_" in token or "-" in token or "." in token:
        return True
    if letters and len(letters) >= 2 and all(character.isupper() for character in letters):
        return True
    if not letters:
        return False
    if letters[0].isupper() and all(character.islower() for character in letters[1:]):
        return True
    return any(character.isupper() for character in letters) and any(
        character.islower() for character in letters
    )


_IDENT_FRAGMENT_RE = re.compile(r"^[A-Za-z][a-z0-9]{1,23}$")
_PROSE_SNAKE_PARTS = frozenset(
    {
        "the",
        "a",
        "an",
        "this",
        "that",
        "these",
        "those",
        "with",
        "for",
